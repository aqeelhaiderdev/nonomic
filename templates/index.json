    "problem_statement_cXPMHJ": {
      "type": "problem-statement",
      "blocks": {
        "column_a38NFN": {
          "type": "column",
          "settings": {
            "eyebrow": "Masking with Fragrance",
            "icon": "waves",
            "body": "<p>Heavy fragrances try to cover bacterial odor. But the bacteria keeps producing it. You're just layering smells — and often making it worse.</p>",
            "body_mobile": "<p>Heavy fragrances cover bacterial odor. The bacteria keeps producing it.</p>"
          }
