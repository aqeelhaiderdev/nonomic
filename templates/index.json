        "collapsible_tab_DqXfR8": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "How It Works",
            "icon": "none",
            "content": "<p>MicroSilver BG™ is a pharmaceutical-grade silver that disrupts bacterial cell function on contact.</p><p>Odor doesn't come from sweat — it comes from bacteria breaking it down.<br/>If bacteria can't function, odor can't form.</p><p>Unlike deodorants that mask with fragrance or irritate with baking soda, MicroSilver targets the source directly.</p><p>One application provides 24+ hour control — without blocking sweat.</p>",
            "page": ""
          }
        },
        "collapsible_tab_XyVxJT": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Full Ingredient List",
            "icon": "none",
            "content": "<p>Caprylic/Capric Triglyceride, Rice Bran Wax, Tapioca Starch, Cocoa Butter, Zinc Oxide, Magnesium Hydroxide, MicroSilver BG™, Zinc Ricinoleate, Triethyl Citrate, Carnauba Wax, Jojoba Esters 60, Rosemary Antioxidant, Essential Oil Blend (except Unscented).</p><p>No aluminum. No baking soda. No synthetic fragrance.</p><p>Essential oils vary by formula. Unscented contains none.</p>",
            "page": ""
          }
        },
        "collapsible_tab_3QmXnb": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "How to Use",
            "icon": "none",
            "content": "<p>Apply to clean, dry underarms once daily.</p><p>For best results, apply after showering.<br/>A few swipes is all you need — no reapplication required.</p>",
            "page": ""
          }
        },
        "collapsible_tab_gBcfkF": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping Information",
            "icon": "none",
            "content": "<p>Free standard shipping on 2-pack and 3-pack orders.<br/>Single stick ships for $5.</p><p>Orders ship within 1–2 business days.<br/>Delivery typically arrives in 3–5 business days.</p><p>Tracking is emailed as soon as your order ships.</p>",
            "page": ""
          }
        },
        "collapsible_tab_qTKjBH": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "45-Day Guarantee",
            "icon": "none",
            "content": "<p>Try it for 45 days.</p><p>If it doesn't outperform your current deodorant, email support@nonomic.com and we'll refund you in full.</p><p>No returns. No forms. No friction.</p><p>One refund per customer, up to $60.</p>",
            "page": ""
          }
        }
