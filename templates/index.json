        "column_8N9gDB": {
          "type": "column",
          "settings": {
            "eyebrow": "Shocking with Baking Soda",
            "icon": "cross",
            "body": "<p>Natural deodorants rely on baking soda to create a harsh pH environment. It works for some — and burns or irritates most. That's not a solution.</p>",
            "body_mobile": "<p>Creates harsh pH. Burns or irritates most. That's not a solution.</p>"
          }
        },
        "column_NeTyqN": {
          "type": "column",
          "settings": {
            "eyebrow": "Blocking with Aluminum",
            "icon": "bar",
            "body": "<p>Antiperspirants physically plug sweat ducts. Effective at stopping sweat — but sweat isn't the problem. And many people prefer not to block a natural process.</p>",
            "body_mobile": "<p>Plugs sweat ducts. But sweat isn't the problem.</p>"
          }
