{% comment %}
  Cart drawer line item card.

  Accepts:
  - item: {LineItem}
{% endcomment %}
{%- liquid
  assign line_index = item.index | plus: 1

  assign bundle_scents = ''
  for property in item.properties
    if property.first == '_Scents'
      assign bundle_scents = property.last
    endif
  endfor

  assign pack_label = ''
  assign scent_label = ''
  if bundle_scents != blank
    assign pack_label = item.variant.title | split: ' / ' | first
    assign scent_label = bundle_scents
  elsif item.product.has_only_default_variant == false
    for option in item.options_with_values
      assign option_name_downcase = option.name | downcase
      if option_name_downcase contains 'pack' or option_name_downcase contains 'stick' or option_name_downcase contains 'size'
        assign pack_label = option.value
      elsif option_name_downcase contains 'scent' or option_name_downcase contains 'fragrance' or option_name_downcase contains 'flavor'
        assign scent_label = option.value
      elsif pack_label == blank
        assign pack_label = option.value
      elsif scent_label == blank
        assign scent_label = option.value
      endif
    endfor
  endif

  assign line_compare = item.original_line_price
  if item.variant.compare_at_price != blank and item.variant.compare_at_price > item.final_price
    assign variant_compare_line = item.variant.compare_at_price | times: item.quantity
    if variant_compare_line > line_compare
      assign line_compare = variant_compare_line
    endif
  endif

  assign line_savings = 0
  assign show_line_compare = false
  if line_compare > item.final_line_price
    assign show_line_compare = true
    assign line_savings = line_compare | minus: item.final_line_price
  endif

  assign has_qty_rules = false
  if item.variant.quantity_rule.increment > 1 or item.variant.quantity_rule.min > 1 or item.variant.quantity_rule.max != null
    assign has_qty_rules = true
  endif

  assign has_vol_pricing = false
  if item.variant.quantity_price_breaks.size > 0
    assign has_vol_pricing = true
  endif

  assign has_selling_plans = false
  if item.product.selling_plan_groups.size > 0
    assign has_selling_plans = true
  endif
-%}

<article
  id="CartDrawer-Item-{{ line_index }}"
  class="cart-drawer-item cart-item{% if item.parent_relationship.parent != null %} cart-item__nested-line{% endif %}"
  {% if item.parent_relationship.parent != null %}
    aria-label="{{- 'products.product.nested_label' | t: title: item.product.title, parent_title: item.parent_relationship.parent.title | escape -}}"
  {% endif %}
>
  {%- render 'loading-spinner', class: 'loading__spinner cart-drawer-item__loader hidden' -%}
  <div class="cart-drawer-item__top">
    <div class="cart-drawer-item__media">
      {%- if item.image -%}
        <a href="{{ item.url }}" class="cart-drawer-item__media-link" tabindex="-1" aria-hidden="true">
          <img
            class="cart-drawer-item__image"
            src="{{ item.image | image_url: width: 120 }}"
            alt="{{ item.image.alt | escape }}"
            loading="lazy"
            width="60"
            height="60"
          >
        </a>
      {%- endif -%}
    </div>

    <div class="cart-drawer-item__info">
      <a href="{{ item.url }}" class="cart-drawer-item__title">{{ item.product.title | escape }}</a>
      {%- if pack_label != blank -%}
        <p class="cart-drawer-item__meta">{{ pack_label | escape }}</p>
      {%- endif -%}
      {%- if scent_label != blank -%}
        <p class="cart-drawer-item__meta">{{ scent_label | escape }}</p>
      {%- elsif bundle_scents == blank and item.product.has_only_default_variant == false -%}
        {%- for option in item.options_with_values -%}
          {%- unless option.value == pack_label -%}
            <p class="cart-drawer-item__meta">{{ option.value | escape }}</p>
          {%- endunless -%}
        {%- endfor -%}
      {%- endif -%}

      {%- for property in item.properties -%}
        {%- assign property_first_char = property.first | slice: 0 -%}
        {%- if property.last != blank and property_first_char != '_' -%}
          <p class="cart-drawer-item__meta">{{ property.first | escape }}: {{ property.last | escape }}</p>
        {%- endif -%}
      {%- endfor -%}

      <ul class="cart-drawer-item__discounts discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
        {%- for discount in item.line_level_discount_allocations -%}
          <li class="discounts__discount">
            {{- 'icon-discount.svg' | inline_asset_content -}}
            {{ discount.discount_application.title }}
          </li>
        {%- endfor -%}
      </ul>
    </div>

    <cart-remove-button
      id="CartDrawer-Remove-{{ line_index }}"
      class="cart-drawer-item__remove"
      data-index="{{ line_index }}"
    >
      <button
        type="button"
        class="cart-drawer-item__remove-button"
        aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
        data-variant-id="{{ item.variant.id }}"
        {% if item.instructions and item.instructions.can_remove == false %}
          disabled
        {% endif %}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 6h18"></path>
          <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
          <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
          <line x1="10" x2="10" y1="11" y2="17"></line>
          <line x1="14" x2="14" y1="11" y2="17"></line>
        </svg>
      </button>
    </cart-remove-button>
  </div>

  <div class="cart-drawer-item__actions">
    <quantity-popover>
      <div class="cart-drawer-item__quantity-row">
        <div class="cart-drawer-item__quantity{% if has_qty_rules or has_vol_pricing %} cart-drawer-item__quantity--info{% endif %}">
          <quantity-input class="quantity cart-quantity cart-drawer-item__quantity-input">
            <button
              class="quantity__button cart-drawer-item__qty-btn"
              name="minus"
              type="button"
              aria-label="{{ 'products.product.quantity.decrease' | t: product: item.product.title | escape }}"
              {% if item.instructions and item.instructions.can_update_quantity == false %}
                disabled
              {% endif %}
            >
              <span aria-hidden="true">−</span>
            </button>
            <input
              class="quantity__input"
              type="number"
              data-quantity-variant-id="{{ item.variant.id }}"
              name="updates[]"
              value="{{ item.quantity }}"
              data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
              min="0"
              data-min="{{ item.variant.quantity_rule.min }}"
              {% if item.variant.quantity_rule.max != null %}
                max="{{ item.variant.quantity_rule.max }}"
              {% endif %}
              step="{{ item.variant.quantity_rule.increment }}"
              aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
              id="Drawer-quantity-{{ line_index }}"
              data-index="{{ line_index }}"
              {% if item.instructions and item.instructions.can_update_quantity == false %}
                disabled
              {% endif %}
            >
            <button
              class="quantity__button cart-drawer-item__qty-btn"
              name="plus"
              type="button"
              aria-label="{{ 'products.product.quantity.increase' | t: product: item.product.title | escape }}"
              {% if item.instructions and item.instructions.can_update_quantity == false %}
                disabled
              {% endif %}
            >
              <span aria-hidden="true">+</span>
            </button>
          </quantity-input>
        </div>

        <div class="cart-drawer-item__line-prices">
          <span class="cart-drawer-item__line-price">{{ item.final_line_price | money }}</span>
          {%- if show_line_compare -%}
            <s class="cart-drawer-item__line-compare">{{ line_compare | money }}</s>
          {%- endif -%}
        </div>
      </div>

      {%- if has_qty_rules or has_vol_pricing -%}
        <button
          type="button"
          class="quantity-popover__info-button quantity-popover__info-button--icon-with-label button button--tertiary visually-hidden"
          aria-expanded="false"
          tabindex="-1"
        >
          <span class="visually-hidden">{{ 'products.product.quantity.note' | t }}</span>
        </button>
        <div class="cart-items__info global-settings-popup quantity-popover__info" tabindex="-1" hidden>
          <div class="quantity__rules caption">
            {%- if item.variant.quantity_rule.increment > 1 -%}
              <span class="divider">
                {{- 'products.product.quantity.multiples_of' | t: quantity: item.variant.quantity_rule.increment -}}
              </span>
            {%- endif -%}
            {%- if item.variant.quantity_rule.min > 1 -%}
              <span class="divider">
                {{- 'products.product.quantity.min_of' | t: quantity: item.variant.quantity_rule.min -}}
              </span>
            {%- endif -%}
            {%- if item.variant.quantity_rule.max != null -%}
              <span class="divider">
                {{- 'products.product.quantity.max_of' | t: quantity: item.variant.quantity_rule.max -}}
              </span>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      <div id="CartDrawer-LineItemError-{{ line_index }}" class="cart-item__error cart-drawer-item__error" role="alert">
        <small class="cart-item__error-text"></small>
      </div>
    </quantity-popover>
  </div>

  {%- if has_selling_plans -%}
    <select
      class="cart-drawer-item__selling-plan-select"
      data-index="{{ line_index }}"
      aria-label="{{ 'products.product.selling_plan' | t | escape }}"
    >
      <optgroup label="{{ 'products.product.one_time' | t }}">
        <option
          value=""
          {% if item.selling_plan_allocation == null %}
            selected
          {% endif %}
        >
          {{ 'products.product.one_time_only' | t }}
        </option>
      </optgroup>
      {%- for group in item.product.selling_plan_groups -%}
        <optgroup label="{{ group.name | escape }}">
          {%- for plan in group.selling_plans -%}
            <option
              value="{{ plan.id }}"
              {% if item.selling_plan_allocation != null and item.selling_plan_allocation.selling_plan.id == plan.id %}
                selected
              {% endif %}
            >
              {{ plan.name | escape }}
            </option>
          {%- endfor -%}
        </optgroup>
      {%- endfor -%}
    </select>
  {%- endif -%}

  {%- if line_savings > 0 -%}
    {%- capture savings_amount -%}{{ line_savings | money }}{%- endcapture -%}
    <p class="cart-drawer-item__savings">
      {{ 'sections.cart.savings_html' | t: amount: savings_amount }}
    </p>
  {%- endif -%}
</article>
