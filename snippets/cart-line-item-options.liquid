{% comment %}
  Cart line variant + properties. When `_Scents` is present (multi-pack), shows pack + comma-separated scents only.

  Accepts:
  - item: cart line_item
  - context: optional. "drawer" uses drawer-specific link attributes; default "page".
{% endcomment %}
{%- liquid
  assign bundle_scents = ''
  for property in item.properties
    if property.first == '_Scents'
      assign bundle_scents = property.last
    endif
  endfor
-%}
{%- if bundle_scents != blank -%}
  {%- assign pack_line = item.variant.title | split: ' / ' | first -%}
  <div class="product-option">{{ pack_line }}</div>
  <div class="product-option">{{ bundle_scents }}</div>
{%- else -%}
  <dl>
    {%- if item.product.has_only_default_variant == false -%}
      {%- for option in item.options_with_values -%}
        <div class="product-option">
          <dt>{{ option.name }}:</dt>
          <dd>
            {{ option.value -}}
            {%- unless forloop.last %}, {% endunless %}
          </dd>
        </div>
      {%- endfor -%}
    {%- endif -%}

    {%- for property in item.properties -%}
      {%- assign property_first_char = property.first | slice: 0 -%}
      {%- if property.last != blank and property_first_char != '_' -%}
        <div class="product-option">
          <dt>{{ property.first }}:</dt>
          <dd>
            {%- if property.last contains '/uploads/' -%}
              {%- if context == 'drawer' -%}
                <a
                  href="{{ property.last }}"
                  class="link"
                  target="_blank"
                  aria-describedby="a11y-new-window-message"
                >
                  {{ property.last | split: '/' | last }}
                </a>
              {%- else -%}
                <a href="{{ property.last }}" class="link" target="_blank">
                  {{ property.last | split: '/' | last }}
                </a>
              {%- endif -%}
            {%- else -%}
              {{ property.last }}
            {%- endif -%}
          </dd>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </dl>
{%- endif -%}
