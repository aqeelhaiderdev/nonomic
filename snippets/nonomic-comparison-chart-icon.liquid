{% comment %}
  Renders check or close icon for the comparison chart.

  Accepts:
  - positive: {Boolean} true = checkmark, false = close
  - tone: {String} 'nonomic' | 'muted'

  Usage:
  {% render 'nonomic-comparison-chart-icon', positive: true, tone: 'nonomic' %}
{% endcomment %}
{%- liquid
  assign tone = tone | default: 'muted'
  assign icon_class = 'nonomic-comparison__icon'
  if positive
    assign icon_class = icon_class | append: ' nonomic-comparison__icon--check nonomic-comparison__icon--tone-' | append: tone
  else
    assign icon_class = icon_class | append: ' nonomic-comparison__icon--close nonomic-comparison__icon--tone-' | append: tone
  endif
-%}
{%- if positive -%}
  <svg
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    class="{{ icon_class }}"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M20 6 9 17l-5-5"/>
  </svg>
{%- else -%}
  <svg
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    class="{{ icon_class }}"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M18 6 6 18"/>
    <path d="m6 6 12 12"/>
  </svg>
{%- endif -%}
