<div class="nonomic-pdp__gallery-trust">
  <div class="nonomic-pdp__gallery-trust-item">
    {%- if section.settings.nonomic_trust_1_icon != 'none' -%}
      <div class="nonomic-pdp__gallery-trust-icon">
        {% render 'nonomic-gallery-trust-icon', icon: section.settings.nonomic_trust_1_icon %}
      </div>
    {%- endif -%}
    <div class="nonomic-pdp__gallery-trust-copy">
      {%- if section.settings.nonomic_trust_1_heading != blank -%}
