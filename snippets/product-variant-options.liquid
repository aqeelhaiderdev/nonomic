{% comment %}
  Renders product variant options

  Accepts:
  - product: {Object} product object.
  - option: {Object} current product_option object.
  - block: {Object} block object.
  - picker_type: {String} type of picker to dispay
  - option_role: {String} optional. Use 'pack' for the Quantity / pack option — adds data-pack-slots for bundle UI.
  - input_name_override: {String} optional (e.g. properties[Scent 2]) for line item properties only.
  - id_variant_prefix: {String} optional prefix for input ids when using input_name_override.
  - variant_data_mode: {Boolean} optional. When false, omits variant option-value dataset attributes (line item properties).
  - property_slot: {Boolean} optional. When true, uses first value as default checked instead of variant state.

  Usage:
  {% render 'product-variant-options',
    product: product,
    option: option,
    block: block,
    picker_type: picker_type
  %}
{% endcomment %}
{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
  if variant_data_mode == nil
    assign variant_data_mode = true
  endif
-%}

{%- for value in option.values -%}
  {%- assign value_str = value | append: '' -%}
  {%- liquid
    assign swatch_focal_point = null
    if value.swatch.image
      assign image_url = value.swatch.image | image_url: width: 50
      assign swatch_value = 'url(' | append: image_url | append: ')'
      assign swatch_focal_point = value.swatch.image.presentation.focal_point
    elsif value.swatch.color
      assign swatch_value = 'rgb(' | append: value.swatch.color.rgb | append: ')'
    else
      assign swatch_value = null
    endif

    assign option_disabled = true
    if value.available
      assign option_disabled = false
    endif

    assign pack_slots = ''
    if option_role == 'pack'
      assign pack_slots = 1
      assign vl = value_str | strip | downcase
      if vl contains '3 pack' or vl == '3-pack'
        assign pack_slots = 3
      elsif vl contains '2 pack' or vl == '2-pack'
        assign pack_slots = 2
      endif
      if pack_slots == 1 and option.values.size == 3
        assign pack_slots = forloop.index
      endif
    endif
  -%}

  {%- capture input_id -%}
    {%- if id_variant_prefix != blank -%}
      {{ section.id }}-{{ id_variant_prefix }}-{{ forloop.index0 -}}
    {%- else -%}
      {{ section.id }}-{{ option.position }}-{{ forloop.index0 -}}
    {%- endif -%}
  {%- endcapture -%}

  {%- capture input_name -%}
    {%- if input_name_override != blank -%}
      {{- input_name_override -}}
    {%- else -%}
      {{ option.name }}-{{ option.position }}
    {%- endif -%}
  {%- endcapture -%}

  {%- if variant_data_mode -%}
    {%- capture input_dataset -%}
      data-product-url="{{ value.product_url }}"
      data-option-value-id="{{ value.id }}"
    {%- endcapture -%}
  {%- else -%}
    {%- assign input_dataset = '' -%}
  {%- endif -%}

  {%- liquid
    assign is_checked = false
    if property_slot
      if forloop.first
        assign is_checked = true
      endif
    elsif value.selected
      assign is_checked = true
    endif
  -%}

  {%- capture label_unavailable -%}
    <span class="visually-hidden label-unavailable">
      {{- 'products.product.variant_sold_out_or_unavailable' | t -}}
    </span>
  {%- endcapture -%}

  {% assign escaped_value = value | escape %}

  {%- if picker_type == 'swatch' -%}
    {%- capture swatch_extra -%}
      {{ input_dataset }}
      {%- if option_role == 'pack' -%}
        data-pack-slots="{{ pack_slots }}"
      {%- endif -%}
    {%- endcapture -%}

    {%- capture help_text -%}
      <span class="visually-hidden">{{ escaped_value }}</span>
      {{ label_unavailable }}
    {%- endcapture -%}

    {%
      render 'swatch-input',
      id: input_id,
      name: input_name,
      value: escaped_value,
      swatch: value.swatch,
      product_form_id: product_form_id,
      checked: is_checked,
      visually_disabled: option_disabled,
      shape: block.settings.swatch_shape,
      help_text: help_text,
      additional_props: swatch_extra
    %}
  {%- elsif picker_type == 'button' -%}
    <input
      type="radio"
      id="{{ input_id }}"
      name="{{ input_name | escape }}"
      value="{{ escaped_value }}"
      form="{{ product_form_id }}"
      {% if is_checked %}
        checked
      {% endif %}
      {% if option_disabled %}
        class="disabled{% if option_role == 'pack' %} js-pack-quantity-input{% endif %}"
      {% elsif option_role == 'pack' %}
        class="js-pack-quantity-input"
      {% endif %}
      {% if option_role == 'pack' %}
        data-pack-slots="{{ pack_slots }}"
      {% endif %}
      {{ input_dataset }}
    >
    <label
      for="{{ input_id }}"
      {%- if section.settings.enable_nonomic_pdp and option_role == 'pack' and picker_type == 'button' -%}
        class="nonomic-pack-card__label"
      {%- elsif section.settings.enable_nonomic_pdp and nonomic_scent_row and picker_type == 'button' -%}
        {%- liquid
          assign scent_variant_for_dot = false
          for variant in product.variants
            if scent_variant_for_dot == false
              assign vopt_scent = ''
              case option.position
                when 1
                  assign vopt_scent = variant.option1
                when 2
                  assign vopt_scent = variant.option2
                when 3
                  assign vopt_scent = variant.option3
              endcase
              if vopt_scent == value_str
                assign scent_variant_for_dot = variant
              endif
            endif
          endfor
          assign scent_dot_rgb = ''
          assign scent_dot_hex = ''
          if scent_variant_for_dot and scent_variant_for_dot.metafields.custom.color_code != blank
            assign scent_color_mf = scent_variant_for_dot.metafields.custom.color_code
            if scent_color_mf.value != blank
              if scent_color_mf.value.rgb != blank
                assign scent_dot_rgb = scent_color_mf.value.rgb
              elsif scent_color_mf.value.hex != blank
                assign scent_dot_hex = scent_color_mf.value.hex
              endif
            endif
          endif
          if scent_dot_rgb == blank and scent_dot_hex == blank and value.swatch and value.swatch.color
            assign scent_dot_rgb = value.swatch.color.rgb
          endif
        -%}
        class="nonomic-scent-chip__label"
        {%- if scent_dot_rgb != blank -%}
          style="--nonomic-scent-dot: rgb({{ scent_dot_rgb }});"
        {%- elsif scent_dot_hex != blank -%}
          style="--nonomic-scent-dot: {{ scent_dot_hex }};"
        {%- endif -%}
      {%- endif -%}
    >
      {%- liquid
        assign nonomic_pack_card = false
        if section.settings.enable_nonomic_pdp and option_role == 'pack' and picker_type == 'button'
          assign nonomic_pack_card = true
        endif
      -%}
      {%- if nonomic_pack_card -%}
        {%- liquid
          assign badge_label = ''
          if block != blank and block.settings.pack_badge_match_2 != blank and value_str == block.settings.pack_badge_match_2
            assign badge_label = block.settings.pack_badge_text_2
          elsif block != blank and block.settings.pack_badge_match_3 != blank and value_str == block.settings.pack_badge_match_3
            assign badge_label = block.settings.pack_badge_text_3
          endif
          assign pack_price_variant = false
          for variant in product.variants
            if pack_price_variant == false
              assign vopt = ''
              case option.position
                when 1
                  assign vopt = variant.option1
                when 2
                  assign vopt = variant.option2
                when 3
                  assign vopt = variant.option3
              endcase
              if vopt == value_str
                assign pack_price_variant = variant
              endif
            endif
          endfor
        -%}
        {%- if badge_label != blank -%}
          <span class="nonomic-pack-card__badge">{{ badge_label }}</span>
        {%- endif -%}
        <span class="nonomic-pack-card__name">{{ value }}</span>
        {%- if pack_price_variant -%}
          <span class="nonomic-pack-card__price">{{ pack_price_variant.price | money_without_trailing_zeros }}</span>
          {%- if pack_slots > 1 -%}
            {%- assign each_cents = pack_price_variant.price | divided_by: pack_slots -%}
            <span class="nonomic-pack-card__each">{{ each_cents | money_without_trailing_zeros }} each</span>
          {%- endif -%}
          {%- if pack_slots > 1 and section.settings.nonomic_pack_free_shipping_label != blank -%}
            <span class="nonomic-pack-card__ship">{{ section.settings.nonomic_pack_free_shipping_label }}</span>
          {%- endif -%}
        {%- endif -%}
      {%- else -%}
        {{ value -}}
      {%- endif -%}
      {{ label_unavailable }}
    </label>
  {%- elsif picker_type == 'dropdown' or picker_type == 'swatch_dropdown' -%}
    <option
      id="{{ input_id }}"
      value="{{ escaped_value }}"
      {% if is_checked %}
        selected="selected"
      {% endif %}
      {% if swatch_value and picker_type == 'swatch_dropdown' %}
        data-option-swatch-value="{{ swatch_value }}"
        {% if swatch_focal_point %}
          data-option-swatch-focal-point="{{ swatch_focal_point }}"
        {% endif %}
      {% endif %}
      {% if option_role == 'pack' %}
        data-pack-slots="{{ pack_slots }}"
      {% endif %}
      {{ input_dataset }}
    >
      {% if option_disabled -%}
        {{- 'products.product.value_unavailable' | t: option_value: value -}}
      {%- else -%}
        {{- value -}}
      {%- endif %}
    </option>
  {%- endif -%}
{%- endfor -%}
