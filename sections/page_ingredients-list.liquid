      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading bottom padding",
      "default": 48
    },
    {
      "type": "range",
