{%- style -%}
  #ScienceClinical-{{ section.id }} {
    --sc-bg: {{ section.settings.background_color }};
    --sc-content-max-width: {{ section.settings.content_max_width }}px;
    --sc-cta-max-width: {{ section.settings.cta_max_width }}px;
    
    --sc-c-heading: {{ section.settings.color_heading }};
    --sc-c-desc: {{ section.settings.color_desc }};
    --sc-c-stat-val: {{ section.settings.color_stat_val }};
    --sc-c-stat-lbl: {{ section.settings.color_stat_lbl }};
    --sc-c-foot: {{ section.settings.color_foot }};
    --sc-c-btn-bg: {{ section.settings.color_btn_bg }};
    --sc-c-btn-text: {{ section.settings.color_btn_text }};
    --sc-c-trust: {{ section.settings.color_trust }};
    --sc-c-trust-icon: {{ section.settings.color_trust_icon }};

    /* Typography Variables (Mobile) */
    --sc-heading-size-mo: {{ section.settings.heading_size_mobile }}px;
    --sc-desc-size-mo: {{ section.settings.desc_size_mobile }}px;
    --sc-stat-val-size-mo: {{ section.settings.stat_val_size_mobile }}px;
    --sc-stat-lbl-size-mo: {{ section.settings.stat_lbl_size_mobile }}px;
    --sc-foot-size-mo: {{ section.settings.foot_size_mobile }}px;
    --sc-btn-size-mo: {{ section.settings.btn_size_mobile }}px;
    --sc-trust-size-mo: {{ section.settings.trust_size_mobile }}px;

    /* Typography Variables (Desktop) */
    --sc-heading-size-dk: {{ section.settings.heading_size_desktop }}px;
    --sc-desc-size-dk: {{ section.settings.desc_size_desktop }}px;
    --sc-stat-val-size-dk: {{ section.settings.stat_val_size_desktop }}px;
    --sc-stat-lbl-size-dk: {{ section.settings.stat_lbl_size_desktop }}px;
    --sc-foot-size-dk: {{ section.settings.foot_size_desktop }}px;
    --sc-btn-size-dk: {{ section.settings.btn_size_desktop }}px;
    --sc-trust-size-dk: {{ section.settings.trust_size_desktop }}px;

    /* Element Spacing Variables (Mobile) */
    --sc-heading-pt-mo: {{ section.settings.heading_padding_top_mobile }}px;
    --sc-heading-pb-mo: {{ section.settings.heading_padding_bottom_mobile }}px;
    --sc-desc-pt-mo: {{ section.settings.desc_padding_top_mobile }}px;
    --sc-desc-pb-mo: {{ section.settings.desc_padding_bottom_mobile }}px;
    --sc-grid-pt-mo: {{ section.settings.grid_padding_top_mobile }}px;
    --sc-grid-pb-mo: {{ section.settings.grid_padding_bottom_mobile }}px;
    --sc-grid-gap-mo: {{ section.settings.grid_gap_mobile }}px;
    --sc-foot-pt-mo: {{ section.settings.foot_padding_top_mobile }}px;
    --sc-foot-pb-mo: {{ section.settings.foot_padding_bottom_mobile }}px;
    --sc-btn-pt-mo: {{ section.settings.btn_padding_top_mobile }}px;
    --sc-btn-pb-mo: {{ section.settings.btn_padding_bottom_mobile }}px;
    --sc-trust-pt-mo: {{ section.settings.trust_padding_top_mobile }}px;
    --sc-trust-pb-mo: {{ section.settings.trust_padding_bottom_mobile }}px;

    /* Element Spacing Variables (Desktop) */
    --sc-heading-pt-dk: {{ section.settings.heading_padding_top_desktop }}px;
    --sc-heading-pb-dk: {{ section.settings.heading_padding_bottom_desktop }}px;
    --sc-desc-pt-dk: {{ section.settings.desc_padding_top_desktop }}px;
    --sc-desc-pb-dk: {{ section.settings.desc_padding_bottom_desktop }}px;
    --sc-grid-pt-dk: {{ section.settings.grid_padding_top_desktop }}px;
    --sc-grid-pb-dk: {{ section.settings.grid_padding_bottom_desktop }}px;
    --sc-grid-gap-dk: {{ section.settings.grid_gap_desktop }}px;
    --sc-foot-pt-dk: {{ section.settings.foot_padding_top_desktop }}px;
    --sc-foot-pb-dk: {{ section.settings.foot_padding_bottom_desktop }}px;
    --sc-btn-pt-dk: {{ section.settings.btn_padding_top_desktop }}px;
    --sc-btn-pb-dk: {{ section.settings.btn_padding_bottom_desktop }}px;
    --sc-trust-pt-dk: {{ section.settings.trust_padding_top_desktop }}px;
    --sc-trust-pb-dk: {{ section.settings.trust_padding_bottom_desktop }}px;

    background-color: var(--sc-bg);
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .science-clinical__inner {
    max-width: var(--sc-content-max-width);
    margin: 0 auto;
    text-align: center;
  }

  .science-clinical__heading {
    margin: 0;
    padding-top: var(--sc-heading-pt-mo);
    padding-bottom: var(--sc-heading-pb-mo);
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-size: var(--sc-heading-size-mo);
    font-weight: 400;
    line-height: 1.1;
    color: var(--sc-c-heading);
    word-break: break-word;
  }

  .science-clinical__desc {
    margin: 0 auto;
    max-width: 720px;
    padding-top: var(--sc-desc-pt-mo);
    padding-bottom: var(--sc-desc-pb-mo);
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-size: var(--sc-desc-size-mo);
    font-weight: 300;
    line-height: 1.7;
    color: var(--sc-c-desc);
  }

  .science-clinical__desc p {
    margin: 0;
    font: inherit;
    color: inherit;
  }

  .science-clinical__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sc-grid-gap-mo);
    padding-top: var(--sc-grid-pt-mo);
    padding-bottom: var(--sc-grid-pb-mo);
  }

  @media screen and (min-width: 750px) {
    .science-clinical__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--sc-grid-gap-dk);
    }
  }

  .science-clinical__stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .science-clinical__stat-val {
    margin: 0 0 8px;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-size: var(--sc-stat-val-size-mo);
    font-weight: 500;
    line-height: 1.1;
    color: var(--sc-c-stat-val);
    font-variant-numeric: tabular-nums;
  }

  .science-clinical__stat-lbl {
    margin: 0;
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-size: var(--sc-stat-lbl-size-mo);
    font-weight: 400;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--sc-c-stat-lbl);
  }

  .science-clinical__foot {
    margin: 0 auto;
    max-width: 820px;
    padding-top: var(--sc-foot-pt-mo);
    padding-bottom: var(--sc-foot-pb-mo);
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-size: var(--sc-foot-size-mo);
    font-weight: 300;
    line-height: 1.6;
    color: var(--sc-c-foot);
  }

  .science-clinical__foot p {
    margin: 0;
    font: inherit;
    color: inherit;
  }

  .science-clinical__cta-section {
    max-width: var(--sc-cta-max-width);
    margin: 0 auto;
    text-align: center;
    padding-top: var(--sc-btn-pt-mo);
    padding-bottom: var(--sc-btn-pb-mo);
  }

  .science-clinical__cta {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    padding: 16px 36px;
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-size: var(--sc-btn-size-mo);
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    color: var(--sc-c-btn-text);
    background-color: var(--sc-c-btn-bg);
    border: 0;
    border-radius: 8px;
    cursor: pointer;
    transition: opacity 0.2s ease;
    min-width: 260px;
  }

  @media screen and (max-width: 749px) {
    .science-clinical__cta {
      width: 100%;
    }
  }

  .science-clinical__cta:hover,
  .science-clinical__cta:focus-visible {
    opacity: 0.9;
  }

  .science-clinical__trust {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding-top: var(--sc-trust-pt-mo);
    padding-bottom: var(--sc-trust-pb-mo);
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-size: var(--sc-trust-size-mo);
    font-weight: 400;
    color: var(--sc-c-trust);
  }

  .science-clinical__trust-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .science-clinical__trust-icon {
    width: 14px;
    height: 14px;
    color: var(--sc-c-trust-icon);
    flex-shrink: 0;
  }

  .science-clinical__trust-dot {
    opacity: 0.5;
  }

  @media screen and (min-width: 750px) {
    .science-clinical__heading {
      font-size: var(--sc-heading-size-dk);
      padding-top: var(--sc-heading-pt-dk);
      padding-bottom: var(--sc-heading-pb-dk);
    }

    .science-clinical__desc {
      font-size: var(--sc-desc-size-dk);
      padding-top: var(--sc-desc-pt-dk);
      padding-bottom: var(--sc-desc-pb-dk);
    }

    .science-clinical__grid {
      padding-top: var(--sc-grid-pt-dk);
      padding-bottom: var(--sc-grid-pb-dk);
    }

    .science-clinical__stat-val {
      font-size: var(--sc-stat-val-size-dk);
    }

    .science-clinical__stat-lbl {
      font-size: var(--sc-stat-lbl-size-dk);
    }

    .science-clinical__foot {
      font-size: var(--sc-foot-size-dk);
      padding-top: var(--sc-foot-pt-dk);
      padding-bottom: var(--sc-foot-pb-dk);
    }

    .science-clinical__cta-section {
      padding-top: var(--sc-btn-pt-dk);
      padding-bottom: var(--sc-btn-pb-dk);
    }

    .science-clinical__cta {
      font-size: var(--sc-btn-size-dk);
    }

    .science-clinical__trust {
      font-size: var(--sc-trust-size-dk);
      padding-top: var(--sc-trust-pt-dk);
      padding-bottom: var(--sc-trust-pb-dk);
    }
  }
{%- endstyle -%}

<div id="ScienceClinical-{{ section.id }}" class="science-clinical section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    
    <div class="science-clinical__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="science-clinical__heading">
          {{ section.settings.heading | newline_to_br }}
        </h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="science-clinical__desc rte">
          {{ section.settings.description }}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="science-clinical__grid">
          {%- for block in section.blocks -%}
            <div class="science-clinical__stat-item" {{ block.shopify_attributes }}>
              {%- if block.settings.value != blank -%}
                <div class="science-clinical__stat-val">{{ block.settings.value | escape }}</div>
              {%- endif -%}
              
              {%- if block.settings.label != blank -%}
                <div class="science-clinical__stat-lbl">{{ block.settings.label | escape }}</div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.footnote != blank -%}
        <div class="science-clinical__foot rte">
          {{ section.settings.footnote }}
        </div>
      {%- endif -%}
    </div>

    <div class="science-clinical__cta-section">
      {%- if section.settings.button_label != blank -%}
        <a class="science-clinical__cta"
          {% if section.settings.button_link == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ section.settings.button_link }}"
          {% endif %}
        >
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}

      {%- if section.settings.trust_1 != blank or section.settings.trust_2 != blank or section.settings.trust_3 != blank -%}
        <div class="science-clinical__trust">
          {%- if section.settings.trust_1 != blank -%}
            <div class="science-clinical__trust-item">
              <svg class="science-clinical__trust-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>{{ section.settings.trust_1 | escape }}</span>
            </div>
          {%- endif -%}

          {%- if section.settings.trust_1 != blank and section.settings.trust_2 != blank -%}
            <span class="science-clinical__trust-dot" aria-hidden="true">·</span>
          {%- endif -%}

          {%- if section.settings.trust_2 != blank -%}
            <div class="science-clinical__trust-item">
              <svg class="science-clinical__trust-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>{{ section.settings.trust_2 | escape }}</span>
            </div>
          {%- endif -%}

          {%- if section.settings.trust_2 != blank and section.settings.trust_3 != blank -%}
            <span class="science-clinical__trust-dot" aria-hidden="true">·</span>
          {%- endif -%}

          {%- if section.settings.trust_3 != blank -%}
            <div class="science-clinical__trust-item">
              <svg class="science-clinical__trust-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>{{ section.settings.trust_3 | escape }}</span>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Science Clinical",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "info": "Use Enter to add line breaks.",
      "default": "Clinical Backing"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>MicroSilver BG™ has been independently tested across institutions including Charité University Research Hospital (Berlin) and the IGSF Institute for Health System Research (Kiel, Germany). On the market since 2005 — 200+ brand customers, 35+ countries, zero reported skin complications.</p>"
    },
    {
      "type": "richtext",
      "id": "footnote",
      "label": "Footnote",
      "default": "<p>99.9% bacterial reduction based on in-vitro testing of MicroSilver BG™ by Bio-Gate AG. 24+ hour mechanism confirmed via in-vivo confocal microscopy, Charité University Research Hospital, Berlin. Zero systemic absorption confirmed via Franz Diffusion Cell testing (CIBA) and in-vivo tape stripping, Institute Dr. Schrader, Germany.</p>"
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Try It Risk-Free for 45 Days →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "trust_1",
      "label": "Trust item 1",
      "default": "45-day guarantee"
    },
    {
      "type": "text",
      "id": "trust_2",
      "label": "Trust item 2",
      "default": "Free returns"
    },
    {
      "type": "text",
      "id": "trust_3",
      "label": "Trust item 3",
      "default": "No subscription required"
    },
    {
      "type": "header",
      "content": "Layout constraints"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 800,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "label": "Top content max width",
      "default": 1280
    },
    {
      "type": "range",
      "id": "cta_max_width",
      "min": 400,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "label": "CTA area max width",
      "default": 720
    },
    {
      "type": "header",
      "content": "Typography (Desktop)"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 40
    },
    {
      "type": "range",
      "id": "desc_size_desktop",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 16
    },
    {
      "type": "range",
      "id": "stat_val_size_desktop",
      "min": 24,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Stat Value size",
      "default": 56
    },
    {
      "type": "range",
      "id": "stat_lbl_size_desktop",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Stat Label size",
      "default": 12
    },
    {
      "type": "range",
      "id": "foot_size_desktop",
      "min": 9,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Footnote size",
      "default": 11
    },
    {
      "type": "range",
      "id": "btn_size_desktop",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Button Text size",
      "default": 15
    },
    {
      "type": "range",
      "id": "trust_size_desktop",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Trust Bar Text size",
      "default": 12
    },
    {
      "type": "header",
      "content": "Typography (Mobile)"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 36
    },
    {
      "type": "range",
      "id": "desc_size_mobile",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 15
    },
    {
      "type": "range",
      "id": "stat_val_size_mobile",
      "min": 24,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Stat Value size",
      "default": 48
    },
    {
      "type": "range",
      "id": "stat_lbl_size_mobile",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Stat Label size",
      "default": 11
    },
    {
      "type": "range",
      "id": "foot_size_mobile",
      "min": 9,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Footnote size",
      "default": 10
    },
    {
      "type": "range",
      "id": "btn_size_mobile",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Button Text size",
      "default": 15
    },
    {
      "type": "range",
      "id": "trust_size_mobile",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Trust Bar Text size",
      "default": 11
    },
    {
      "type": "header",
      "content": "Element Spacing (Desktop)"
    },
    {
      "type": "range",
      "id": "heading_padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading bottom padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "desc_padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Description top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "desc_padding_bottom_desktop",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Description bottom padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "grid_padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Stats Grid top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "grid_padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Stats Grid bottom padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "grid_gap_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Gap between stats",
      "default": 32
    },
    {
      "type": "range",
      "id": "foot_padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Footnote top padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "foot_padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Footnote bottom padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "btn_padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "CTA container top padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "btn_padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "CTA container bottom margin",
      "default": 16
    },
    {
      "type": "range",
      "id": "trust_padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Trust Bar top padding",
      "default": 0
    },
