    },
    {
      "type": "range",
      "id": "btn_padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Button bottom padding",
      "default": 0
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "color_heading",
      "label": "Heading text",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Description text",
      "default": "#4B5A6B"
    },
    {
