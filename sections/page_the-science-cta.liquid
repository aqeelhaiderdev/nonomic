{%- style -%}
  #ScienceCTA-{{ section.id }} {
    --scta-bg: {{ section.settings.background_color }};
    --scta-content-max-width: {{ section.settings.content_max_width }}px;
    
    --scta-c-heading: {{ section.settings.color_heading }};
    --scta-c-text: {{ section.settings.color_text }};
    --scta-c-btn-bg: {{ section.settings.color_btn_bg }};
    --scta-c-btn-text: {{ section.settings.color_btn_text }};

    /* Typography Variables (Mobile) */
    --scta-heading-size-mo: {{ section.settings.heading_size_mobile }}px;
    --scta-text-size-mo: {{ section.settings.text_size_mobile }}px;
    --scta-btn-size-mo: {{ section.settings.btn_size_mobile }}px;

    /* Typography Variables (Desktop) */
    --scta-heading-size-dk: {{ section.settings.heading_size_desktop }}px;
    --scta-text-size-dk: {{ section.settings.text_size_desktop }}px;
    --scta-btn-size-dk: {{ section.settings.btn_size_desktop }}px;

    /* Element Spacing Variables (Mobile) */
    --scta-heading-pt-mo: {{ section.settings.heading_padding_top_mobile }}px;
    --scta-heading-pb-mo: {{ section.settings.heading_padding_bottom_mobile }}px;
    --scta-text-pt-mo: {{ section.settings.text_padding_top_mobile }}px;
    --scta-text-pb-mo: {{ section.settings.text_padding_bottom_mobile }}px;
    --scta-btn-pt-mo: {{ section.settings.btn_padding_top_mobile }}px;
    --scta-btn-pb-mo: {{ section.settings.btn_padding_bottom_mobile }}px;

    /* Element Spacing Variables (Desktop) */
    --scta-heading-pt-dk: {{ section.settings.heading_padding_top_desktop }}px;
    --scta-heading-pb-dk: {{ section.settings.heading_padding_bottom_desktop }}px;
    --scta-text-pt-dk: {{ section.settings.text_padding_top_desktop }}px;
    --scta-text-pb-dk: {{ section.settings.text_padding_bottom_desktop }}px;
    --scta-btn-pt-dk: {{ section.settings.btn_padding_top_desktop }}px;
    --scta-btn-pb-dk: {{ section.settings.btn_padding_bottom_desktop }}px;

    background-color: var(--scta-bg);
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .science-cta__inner {
    max-width: var(--scta-content-max-width);
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .science-cta__heading {
    margin: 0;
    padding-top: var(--scta-heading-pt-mo);
    padding-bottom: var(--scta-heading-pb-mo);
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-size: var(--scta-heading-size-mo);
    font-weight: 400;
    line-height: 1.2;
    color: var(--scta-c-heading);
    word-break: break-word;
  }

  .science-cta__text {
    margin: 0;
    padding-top: var(--scta-text-pt-mo);
    padding-bottom: var(--scta-text-pb-mo);
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-size: var(--scta-text-size-mo);
    font-weight: 300;
    line-height: 1.7;
    color: var(--scta-c-text);
  }

  .science-cta__text p {
    margin: 0;
    font: inherit;
    color: inherit;
  }

  .science-cta__button-wrapper {
    padding-top: var(--scta-btn-pt-mo);
    padding-bottom: var(--scta-btn-pb-mo);
    width: 100%;
  }

  .science-cta__button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    padding: 16px 36px;
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-size: var(--scta-btn-size-mo);
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    color: var(--scta-c-btn-text);
    background-color: var(--scta-c-btn-bg);
    border: 0;
    border-radius: 8px;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .science-cta__button:hover,
  .science-cta__button:focus-visible {
    opacity: 0.9;
  }

  .science-cta__button[aria-disabled='true'] {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .science-cta__button {
      width: 100%;
      max-width: 320px;
    }
  }

  @media screen and (min-width: 750px) {
    .science-cta__heading {
      font-size: var(--scta-heading-size-dk);
      padding-top: var(--scta-heading-pt-dk);
      padding-bottom: var(--scta-heading-pb-dk);
    }

    .science-cta__text {
      font-size: var(--scta-text-size-dk);
      padding-top: var(--scta-text-pt-dk);
      padding-bottom: var(--scta-text-pb-dk);
    }

    .science-cta__button-wrapper {
      padding-top: var(--scta-btn-pt-dk);
      padding-bottom: var(--scta-btn-pb-dk);
    }

    .science-cta__button {
      font-size: var(--scta-btn-size-dk);
    }
  }
{%- endstyle -%}

<div id="ScienceCTA-{{ section.id }}" class="science-cta section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <div class="science-cta__inner">
      
      {%- if section.settings.heading != blank -%}
        <h2 class="science-cta__heading">
          {{ section.settings.heading | newline_to_br }}
        </h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="science-cta__text rte">
          {{ section.settings.text }}
        </div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <div class="science-cta__button-wrapper">
          <a class="science-cta__button"
            {% if section.settings.button_link == blank %}
              role="link" aria-disabled="true"
            {% else %}
              href="{{ section.settings.button_link }}"
            {% endif %}
          >
            {{ section.settings.button_label | escape }}
          </a>
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Science CTA",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "info": "Use Enter to add line breaks.",
      "default": "Most deodorants ask you to trust the brand. We built ours around a mechanism."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>No wellness theater. No vague claims. Just mechanism-first formulation designed to eliminate odor without compromise.</p>"
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Choose Your Formula →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout constraints"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 400,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "label": "Content max width",
      "default": 720
    },
    {
      "type": "header",
      "content": "Typography (Desktop)"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 36
    },
    {
      "type": "range",
      "id": "text_size_desktop",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 16
    },
    {
      "type": "range",
      "id": "btn_size_desktop",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Button Text size",
      "default": 15
    },
    {
      "type": "header",
      "content": "Typography (Mobile)"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 28
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 15
    },
    {
      "type": "range",
      "id": "btn_size_mobile",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Button Text size",
      "default": 15
    },
    {
      "type": "header",
      "content": "Element Spacing (Desktop)"
    },
    {
      "type": "range",
      "id": "heading_padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading bottom padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "text_padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Description top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "text_padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Description bottom padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "btn_padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Button top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "btn_padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Button bottom padding",
      "default": 0
    },
    {
      "type": "header",
      "content": "Element Spacing (Mobile)"
    },
    {
      "type": "range",
      "id": "heading_padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading bottom padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "text_padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Description top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "text_padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Description bottom padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "btn_padding_top_mobile",
      "min": 0,
      "max": 100,
