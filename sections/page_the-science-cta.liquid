      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Science CTA"
    }
  ]
}
{% endschema %}