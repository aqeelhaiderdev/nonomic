{%- style -%}
  #ReturnsInfo-{{ section.id }} {
    --ri-bg: {{ section.settings.background_color }};
    --ri-content-max-width: {{ section.settings.content_max_width }}px;
    
    --ri-c-heading: {{ section.settings.color_heading }};
    --ri-c-block-heading: {{ section.settings.color_block_heading }};
    --ri-c-block-text: {{ section.settings.color_block_text }};

    /* Typography Variables (Mobile) */
    --ri-heading-size-mo: {{ section.settings.heading_size_mobile }}px;
    --ri-block-heading-size-mo: {{ section.settings.block_heading_size_mobile }}px;
    --ri-block-text-size-mo: {{ section.settings.block_text_size_mobile }}px;

    /* Typography Variables (Desktop) */
    --ri-heading-size-dk: {{ section.settings.heading_size_desktop }}px;
    --ri-block-heading-size-dk: {{ section.settings.block_heading_size_desktop }}px;
    --ri-block-text-size-dk: {{ section.settings.block_text_size_desktop }}px;

    /* Element Spacing Variables (Mobile) */
    --ri-heading-pb-mo: {{ section.settings.heading_padding_bottom_mobile }}px;
    --ri-gap-mo: {{ section.settings.block_gap_mobile }}px;
    --ri-block-heading-pb-mo: {{ section.settings.block_heading_padding_bottom_mobile }}px;

    /* Element Spacing Variables (Desktop) */
    --ri-heading-pb-dk: {{ section.settings.heading_padding_bottom_desktop }}px;
    --ri-gap-dk: {{ section.settings.block_gap_desktop }}px;
    --ri-block-heading-pb-dk: {{ section.settings.block_heading_padding_bottom_desktop }}px;

    background-color: var(--ri-bg);
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .returns-info__inner {
    max-width: var(--ri-content-max-width);
    margin: 0 auto;
  }

  .returns-info__heading {
    margin: 0 0 var(--ri-heading-pb-mo);
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-size: var(--ri-heading-size-mo);
    font-weight: 400;
    line-height: 1.2;
    color: var(--ri-c-heading);
  }

  .returns-info__list {
    display: flex;
    flex-direction: column;
    gap: var(--ri-gap-mo);
  }

  .returns-info__block-heading {
    margin: 0 0 var(--ri-block-heading-pb-mo);
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-size: var(--ri-block-heading-size-mo);
    font-weight: 500;
    color: var(--ri-c-block-heading);
  }

  .returns-info__block-text {
    margin: 0;
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-size: var(--ri-block-text-size-mo);
    font-weight: 300;
    line-height: 1.7;
    color: var(--ri-c-block-text);
  }

  .returns-info__block-text p {
    margin: 0 0 12px;
    font: inherit;
    color: inherit;
  }

  .returns-info__block-text p:last-child {
    margin-bottom: 0;
  }

  .returns-info__block-text ul {
    padding-left: 24px;
    margin: 0 0 12px;
    list-style-type: disc;
  }

  .returns-info__block-text ul:last-child {
    margin-bottom: 0;
  }

  .returns-info__block-text li {
    margin-bottom: 8px;
    font: inherit;
    color: inherit;
  }

  .returns-info__block-text li:last-child {
    margin-bottom: 0;
  }

  @media screen and (min-width: 750px) {
    .returns-info__heading {
      font-size: var(--ri-heading-size-dk);
      margin-bottom: var(--ri-heading-pb-dk);
    }

    .returns-info__list {
      gap: var(--ri-gap-dk);
    }

    .returns-info__block-heading {
      font-size: var(--ri-block-heading-size-dk);
      margin-bottom: var(--ri-block-heading-pb-dk);
    }

    .returns-info__block-text {
      font-size: var(--ri-block-text-size-dk);
    }
  }
{%- endstyle -%}

<div id="ReturnsInfo-{{ section.id }}" class="returns-info section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <div class="returns-info__inner">
      
      {%- if section.settings.heading != blank -%}
        <h2 class="returns-info__heading">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="returns-info__list">
          {%- for block in section.blocks -%}
            <div class="returns-info__block" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h3 class="returns-info__block-heading">{{ block.settings.heading | escape }}</h3>
              {%- endif -%}
              
              {%- if block.settings.text != blank -%}
                <div class="returns-info__block-text rte">
                  {{ block.settings.text }}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Returns Info",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Returns"
    },
    {
      "type": "header",
      "content": "Layout constraints"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 400,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "label": "Content max width",
      "default": 840
    },
    {
      "type": "header",
      "content": "Typography (Desktop)"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 40
    },
    {
      "type": "range",
      "id": "block_heading_size_desktop",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Block Heading size",
      "default": 16
    },
    {
      "type": "range",
      "id": "block_text_size_desktop",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Block Text size",
      "default": 14
    },
    {
      "type": "header",
      "content": "Typography (Mobile)"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 32
    },
    {
      "type": "range",
      "id": "block_heading_size_mobile",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Block Heading size",
      "default": 16
    },
    {
      "type": "range",
      "id": "block_text_size_mobile",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Block Text size",
      "default": 14
    },
    {
      "type": "header",
      "content": "Element Spacing (Desktop)"
    },
    {
      "type": "range",
      "id": "heading_padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading bottom padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "block_gap_desktop",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Gap between blocks",
      "default": 24
    },
    {
      "type": "range",
      "id": "block_heading_padding_bottom_desktop",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Block heading bottom margin",
      "default": 8
    },
    {
      "type": "header",
      "content": "Element Spacing (Mobile)"
    },
    {
      "type": "range",
      "id": "heading_padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading bottom padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "block_gap_mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Gap between blocks",
      "default": 24
    },
    {
      "type": "range",
      "id": "block_heading_padding_bottom_mobile",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Block heading bottom margin",
      "default": 8
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#EBEEF2"
    },
    {
      "type": "color",
      "id": "color_heading",
      "label": "Heading text",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "color_block_heading",
      "label": "Block heading text",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "color_block_text",
      "label": "Block text",
      "default": "#4B5A6B"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "info_block",
      "name": "Info Block",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "45-Day Return Window"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Try Nonomic for up to 45 days. If your first order doesn't work for you, email us for a full refund. Keep the product. No questions asked.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shipping Returns Info",
      "blocks": [
        {
          "type": "info_block",
          "settings": {
            "heading": "45-Day Return Window",
            "text": "<p>Try Nonomic for up to 45 days. If your first order doesn't work for you, email us for a full refund. Keep the product. No questions asked.</p>"
          }
        },
        {
          "type": "info_block",
          "settings": {
            "heading": "How to Return",
            "text": "<p>Email us at returns@nonomic.com within 45 days of your first order. No shipping required — keep the product.</p>"
          }
        },
        {
          "type": "info_block",
          "settings": {
            "heading": "Condition",
            "text": "<p>Applies to first orders only, up to $60. One refund per customer.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}