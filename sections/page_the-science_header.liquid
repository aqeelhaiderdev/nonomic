    },
    {
      "type": "range",
      "id": "description_padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Description top padding (Desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "description_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Description bottom padding (Desktop)",
      "default": 24
    },
    {
      "type": "range",
