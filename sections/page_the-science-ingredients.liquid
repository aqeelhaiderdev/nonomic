      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Card Description size",
      "default": 14
    },
    {
      "type": "range",
      "id": "link_size_desktop",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Link size",
      "default": 12
    },
    {
      "type": "header",
      "content": "Typography (Mobile)"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 36
    },
    {
      "type": "range",
      "id": "card_name_size_mobile",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Card Name size",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_role_size_mobile",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Card Role size",
      "default": 12
    },
    {
      "type": "range",
      "id": "card_desc_size_mobile",
      "min": 12,
