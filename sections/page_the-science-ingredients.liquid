          "type": "ingredient",
          "settings": {
            "name": "Triethyl Citrate",
            "role": "ENZYMATIC CONTROL",
            "description": "<p>Manages the enzymatic breakdown of proteins and lipids. Acts as a secondary defense layer, reducing the formation of odor compounds even if bacteria are present.</p>"
          }
        },
