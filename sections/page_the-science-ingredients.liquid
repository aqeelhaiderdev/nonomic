{%- style -%}
  #ScienceIngredients-{{ section.id }} {
    --si-bg: {{ section.settings.background_color }};
    --si-content-max-width: {{ section.settings.content_max_width }}px;
    
    --si-c-heading: {{ section.settings.color_heading }};
    --si-c-card-bg: {{ section.settings.color_card_bg }};
    --si-c-card-border: {{ section.settings.color_card_border }};
    --si-c-card-name: {{ section.settings.color_card_name }};
    --si-c-card-role: {{ section.settings.color_card_role }};
    --si-c-card-desc: {{ section.settings.color_card_desc }};
    --si-c-link: {{ section.settings.color_link }};

    /* Typography Variables (Mobile) */
    --si-heading-size-mo: {{ section.settings.heading_size_mobile }}px;
    --si-card-name-size-mo: {{ section.settings.card_name_size_mobile }}px;
    --si-card-role-size-mo: {{ section.settings.card_role_size_mobile }}px;
    --si-card-desc-size-mo: {{ section.settings.card_desc_size_mobile }}px;
    --si-link-size-mo: {{ section.settings.link_size_mobile }}px;

    /* Typography Variables (Desktop) */
    --si-heading-size-dk: {{ section.settings.heading_size_desktop }}px;
    --si-card-name-size-dk: {{ section.settings.card_name_size_desktop }}px;
    --si-card-role-size-dk: {{ section.settings.card_role_size_desktop }}px;
    --si-card-desc-size-dk: {{ section.settings.card_desc_size_desktop }}px;
    --si-link-size-dk: {{ section.settings.link_size_desktop }}px;

    /* Element Spacing Variables (Mobile) */
    --si-heading-pt-mo: {{ section.settings.heading_padding_top_mobile }}px;
    --si-heading-pb-mo: {{ section.settings.heading_padding_bottom_mobile }}px;
    --si-grid-pt-mo: {{ section.settings.grid_padding_top_mobile }}px;
    --si-grid-pb-mo: {{ section.settings.grid_padding_bottom_mobile }}px;
    --si-grid-gap-mo: {{ section.settings.grid_gap_mobile }}px;
    --si-card-pt-mo: {{ section.settings.card_padding_top_mobile }}px;
    --si-card-pb-mo: {{ section.settings.card_padding_bottom_mobile }}px;
    --si-card-px-mo: {{ section.settings.card_padding_horizontal_mobile }}px;
    --si-link-pt-mo: {{ section.settings.link_padding_top_mobile }}px;
    --si-link-pb-mo: {{ section.settings.link_padding_bottom_mobile }}px;

    /* Element Spacing Variables (Desktop) */
    --si-heading-pt-dk: {{ section.settings.heading_padding_top_desktop }}px;
    --si-heading-pb-dk: {{ section.settings.heading_padding_bottom_desktop }}px;
    --si-grid-pt-dk: {{ section.settings.grid_padding_top_desktop }}px;
    --si-grid-pb-dk: {{ section.settings.grid_padding_bottom_desktop }}px;
    --si-grid-gap-dk: {{ section.settings.grid_gap_desktop }}px;
    --si-card-pt-dk: {{ section.settings.card_padding_top_desktop }}px;
    --si-card-pb-dk: {{ section.settings.card_padding_bottom_desktop }}px;
    --si-card-px-dk: {{ section.settings.card_padding_horizontal_desktop }}px;
    --si-link-pt-dk: {{ section.settings.link_padding_top_desktop }}px;
    --si-link-pb-dk: {{ section.settings.link_padding_bottom_desktop }}px;

    background-color: var(--si-bg);
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .science-ingredients__inner {
    max-width: var(--si-content-max-width);
    margin: 0 auto;
  }

  .science-ingredients__heading {
    margin: 0;
    padding-top: var(--si-heading-pt-mo);
    padding-bottom: var(--si-heading-pb-mo);
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-size: var(--si-heading-size-mo);
    font-weight: 400;
    line-height: 1.1;
    color: var(--si-c-heading);
    word-break: break-word;
  }

  .science-ingredients__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--si-grid-gap-mo);
    padding-top: var(--si-grid-pt-mo);
    padding-bottom: var(--si-grid-pb-mo);
  }

  @media screen and (min-width: 750px) {
    .science-ingredients__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--si-grid-gap-dk);
      padding-top: var(--si-grid-pt-dk);
      padding-bottom: var(--si-grid-pb-dk);
    }
  }

  .science-ingredients__card {
    background-color: var(--si-c-card-bg);
    border: 0.5px solid var(--si-c-card-border);
    border-radius: 8px;
    padding: var(--si-card-pt-mo) var(--si-card-px-mo) var(--si-card-pb-mo);
    display: flex;
    flex-direction: column;
  }

  .science-ingredients__card-name {
    margin: 0 0 8px;
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-size: var(--si-card-name-size-mo);
    font-weight: 500;
    color: var(--si-c-card-name);
  }

  .science-ingredients__card-role {
    margin: 0 0 12px;
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-size: var(--si-card-role-size-mo);
    font-weight: 400;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--si-c-card-role);
  }

  .science-ingredients__card-desc {
    margin: 0;
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-size: var(--si-card-desc-size-mo);
    font-weight: 300;
    line-height: 1.7;
    color: var(--si-c-card-desc);
  }

  .science-ingredients__card-desc p {
    margin: 0;
    font: inherit;
    color: inherit;
  }

  .science-ingredients__footer {
    text-align: center;
    padding-top: var(--si-link-pt-mo);
    padding-bottom: var(--si-link-pb-mo);
  }

  .science-ingredients__link {
    display: inline-block;
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-size: var(--si-link-size-mo);
    font-weight: 300;
    color: var(--si-c-link);
    text-decoration: underline;
    background: none;
    border: none;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .science-ingredients__link:hover {
    opacity: 0.7;
  }

  @media screen and (min-width: 750px) {
    .science-ingredients__heading {
      font-size: var(--si-heading-size-dk);
      padding-top: var(--si-heading-pt-dk);
      padding-bottom: var(--si-heading-pb-dk);
    }

    .science-ingredients__card {
      padding: var(--si-card-pt-dk) var(--si-card-px-dk) var(--si-card-pb-dk);
    }

    .science-ingredients__card-name {
      font-size: var(--si-card-name-size-dk);
    }

    .science-ingredients__card-role {
      font-size: var(--si-card-role-size-dk);
    }

    .science-ingredients__card-desc {
      font-size: var(--si-card-desc-size-dk);
    }

    .science-ingredients__footer {
      padding-top: var(--si-link-pt-dk);
      padding-bottom: var(--si-link-pb-dk);
    }

    .science-ingredients__link {
      font-size: var(--si-link-size-dk);
    }
  }
{%- endstyle -%}

<div id="ScienceIngredients-{{ section.id }}" class="science-ingredients section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <div class="science-ingredients__inner">
      
      {%- if section.settings.heading != blank -%}
        <h2 class="science-ingredients__heading">
          {{ section.settings.heading | newline_to_br }}
        </h2>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="science-ingredients__grid">
          {%- for block in section.blocks -%}
            <div class="science-ingredients__card" {{ block.shopify_attributes }}>
              {%- if block.settings.name != blank -%}
                <h3 class="science-ingredients__card-name">{{ block.settings.name | escape }}</h3>
              {%- endif -%}
              
              {%- if block.settings.role != blank -%}
                <div class="science-ingredients__card-role">{{ block.settings.role | escape }}</div>
              {%- endif -%}
              
              {%- if block.settings.description != blank -%}
                <div class="science-ingredients__card-desc">{{ block.settings.description }}</div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.link_label != blank -%}
        <div class="science-ingredients__footer">
          <a class="science-ingredients__link"
            {% if section.settings.link_url == blank %}
              role="link" aria-disabled="true"
            {% else %}
              href="{{ section.settings.link_url }}"
            {% endif %}
          >
            {{ section.settings.link_label | escape }}
          </a>
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Science Ingredients",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
