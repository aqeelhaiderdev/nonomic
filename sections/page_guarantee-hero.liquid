{%- style -%}
  #GuaranteeHero-{{ section.id }} {
    --gh-bg: {{ section.settings.background_color }};
    --gh-content-max-width: {{ section.settings.content_max_width }}px;
    --gh-heading-max-width: {{ section.settings.heading_max_width }}px;
    --gh-text-max-width: {{ section.settings.text_max_width }}px;
    
    --gh-c-eyebrow: {{ section.settings.color_eyebrow }};
    --gh-c-heading: {{ section.settings.color_heading }};
    --gh-c-desc: {{ section.settings.color_desc }};

    /* Typography Variables (Mobile) */
    --gh-eyebrow-size-mo: {{ section.settings.eyebrow_size_mobile }}px;
    --gh-heading-size-mo: {{ section.settings.heading_size_mobile }}px;
    --gh-desc-size-mo: {{ section.settings.desc_size_mobile }}px;

    /* Typography Variables (Desktop) */
    --gh-eyebrow-size-dk: {{ section.settings.eyebrow_size_desktop }}px;
    --gh-heading-size-dk: {{ section.settings.heading_size_desktop }}px;
    --gh-desc-size-dk: {{ section.settings.desc_size_desktop }}px;

    /* Element Spacing Variables (Mobile) */
    --gh-eyebrow-pt-mo: {{ section.settings.eyebrow_padding_top_mobile }}px;
    --gh-eyebrow-pb-mo: {{ section.settings.eyebrow_padding_bottom_mobile }}px;
    --gh-heading-pt-mo: {{ section.settings.heading_padding_top_mobile }}px;
    --gh-heading-pb-mo: {{ section.settings.heading_padding_bottom_mobile }}px;
    --gh-desc-pt-mo: {{ section.settings.desc_padding_top_mobile }}px;
    --gh-desc-pb-mo: {{ section.settings.desc_padding_bottom_mobile }}px;

    /* Element Spacing Variables (Desktop) */
    --gh-eyebrow-pt-dk: {{ section.settings.eyebrow_padding_top_desktop }}px;
    --gh-eyebrow-pb-dk: {{ section.settings.eyebrow_padding_bottom_desktop }}px;
    --gh-heading-pt-dk: {{ section.settings.heading_padding_top_desktop }}px;
    --gh-heading-pb-dk: {{ section.settings.heading_padding_bottom_desktop }}px;
    --gh-desc-pt-dk: {{ section.settings.desc_padding_top_desktop }}px;
    --gh-desc-pb-dk: {{ section.settings.desc_padding_bottom_desktop }}px;

    background-color: var(--gh-bg);
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .guarantee-hero__inner {
    max-width: var(--gh-content-max-width);
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .guarantee-hero__eyebrow {
    margin: 0;
    padding-top: var(--gh-eyebrow-pt-mo);
    padding-bottom: var(--gh-eyebrow-pb-mo);
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-size: var(--gh-eyebrow-size-mo);
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gh-c-eyebrow);
  }

  .guarantee-hero__heading {
    margin: 0 auto;
    max-width: var(--gh-heading-max-width);
    padding-top: var(--gh-heading-pt-mo);
    padding-bottom: var(--gh-heading-pb-mo);
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-size: var(--gh-heading-size-mo);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--gh-c-heading);
    word-break: break-word;
  }

  .guarantee-hero__desc {
    margin: 0 auto;
    max-width: var(--gh-text-max-width);
    padding-top: var(--gh-desc-pt-mo);
    padding-bottom: var(--gh-desc-pb-mo);
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-size: var(--gh-desc-size-mo);
    font-weight: 300;
    line-height: 1.6;
    color: var(--gh-c-desc);
  }

  .guarantee-hero__desc p {
    margin: 0;
    font: inherit;
    color: inherit;
  }

  @media screen and (min-width: 750px) {
    .guarantee-hero__eyebrow {
      font-size: var(--gh-eyebrow-size-dk);
      padding-top: var(--gh-eyebrow-pt-dk);
      padding-bottom: var(--gh-eyebrow-pb-dk);
    }
    
    .guarantee-hero__heading {
      font-size: var(--gh-heading-size-dk);
      padding-top: var(--gh-heading-pt-dk);
      padding-bottom: var(--gh-heading-pb-dk);
    }

    .guarantee-hero__desc {
      font-size: var(--gh-desc-size-dk);
      padding-top: var(--gh-desc-pt-dk);
      padding-bottom: var(--gh-desc-pb-dk);
    }
  }
{%- endstyle -%}

<div id="GuaranteeHero-{{ section.id }}" class="guarantee-hero section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <div class="guarantee-hero__inner">
      
      {%- if section.settings.eyebrow != blank -%}
        <div class="guarantee-hero__eyebrow">
          {{- section.settings.eyebrow | escape -}}
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="guarantee-hero__heading">
          {{ section.settings.heading | newline_to_br }}
        </h1>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="guarantee-hero__desc rte">
          {{ section.settings.description }}
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Guarantee Hero",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "45-DAY GUARANTEE"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "info": "Use Enter to add line breaks.",
      "default": "Use It for 45 Days.\nDecide for Yourself."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>We're confident the mechanism works. If it doesn't work for you, we'll refund you. No questions. No hoops.</p>"
    },
    {
      "type": "header",
      "content": "Layout constraints"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 400,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Section max width",
      "default": 1440
    },
    {
      "type": "range",
      "id": "heading_max_width",
      "min": 400,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "label": "Heading max width",
      "default": 900
    },
    {
      "type": "range",
      "id": "text_max_width",
      "min": 400,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "label": "Text max width",
      "default": 640
    },
    {
      "type": "header",
      "content": "Typography (Desktop)"
    },
    {
      "type": "range",
      "id": "eyebrow_size_desktop",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Eyebrow size",
      "default": 11
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "min": 24,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 72
    },
    {
      "type": "range",
      "id": "desc_size_desktop",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 18
    },
    {
      "type": "header",
      "content": "Typography (Mobile)"
    },
    {
      "type": "range",
      "id": "eyebrow_size_mobile",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Eyebrow size",
      "default": 11
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 42
    },
    {
      "type": "range",
      "id": "desc_size_mobile",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Element Spacing (Desktop)"
    },
    {
      "type": "range",
      "id": "eyebrow_padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Eyebrow top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "eyebrow_padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Eyebrow bottom padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "heading_padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading bottom padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "desc_padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Description top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "desc_padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Description bottom padding",
      "default": 0
    },
    {
      "type": "header",
      "content": "Element Spacing (Mobile)"
    },
    {
      "type": "range",
      "id": "eyebrow_padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Eyebrow top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "eyebrow_padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Eyebrow bottom padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "heading_padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading bottom padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "desc_padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Description top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "desc_padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Description bottom padding",
      "default": 0
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#1A2B3C"
    },
    {
      "type": "color",
      "id": "color_eyebrow",
      "label": "Eyebrow text",
      "default": "#7A8899"
    },
    {
      "type": "color",
      "id": "color_heading",
      "label": "Heading text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "color_desc",
