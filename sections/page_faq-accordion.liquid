{%- style -%}
  #FaqAccordion-{{ section.id }} {
    --fa-bg: {{ section.settings.background_color }};
    --fa-content-max-width: {{ section.settings.content_max_width }}px;
    
    --fa-c-item-bg: {{ section.settings.color_item_bg }};
    --fa-c-item-bg-open: {{ section.settings.color_item_bg_open }};
    --fa-c-item-border: {{ section.settings.color_item_border }};
    --fa-c-question: {{ section.settings.color_question }};
    --fa-c-answer: {{ section.settings.color_answer }};
    --fa-c-icon: {{ section.settings.color_icon }};

    /* Typography Variables (Mobile) */
    --fa-question-size-mo: {{ section.settings.question_size_mobile }}px;
    --fa-answer-size-mo: {{ section.settings.answer_size_mobile }}px;

    /* Typography Variables (Desktop) */
    --fa-question-size-dk: {{ section.settings.question_size_desktop }}px;
    --fa-answer-size-dk: {{ section.settings.answer_size_desktop }}px;

    /* Element Spacing Variables (Mobile) */
    --fa-item-gap-mo: {{ section.settings.item_gap_mobile }}px;
    --fa-item-py-mo: {{ section.settings.item_padding_y_mobile }}px;
    --fa-item-px-mo: {{ section.settings.item_padding_x_mobile }}px;

    /* Element Spacing Variables (Desktop) */
    --fa-item-gap-dk: {{ section.settings.item_gap_desktop }}px;
    --fa-item-py-dk: {{ section.settings.item_padding_y_desktop }}px;
    --fa-item-px-dk: {{ section.settings.item_padding_x_desktop }}px;

    background-color: var(--fa-bg);
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .faq-accordion__inner {
    max-width: var(--fa-content-max-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--fa-item-gap-mo);
  }

  @media screen and (min-width: 750px) {
    .faq-accordion__inner {
      gap: var(--fa-item-gap-dk);
    }
  }

  .faq-accordion__item {
    background-color: var(--fa-c-item-bg);
    border: 0.5px solid var(--fa-c-item-border);
    border-radius: 8px;
    overflow: hidden;
    transition: background-color 0.2s ease;
  }

  /* Target the open state of the native details element */
  .faq-accordion__item[open] {
    background-color: var(--fa-c-item-bg-open);
  }

  .faq-accordion__question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    width: 100%;
    padding: var(--fa-item-py-mo) var(--fa-item-px-mo);
    cursor: pointer;
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-size: var(--fa-question-size-mo);
    font-weight: 500;
    color: var(--fa-c-question);
    transition: opacity 0.2s ease;
    /* Remove default markers */
    list-style: none; 
  }

  .faq-accordion__question:hover {
    opacity: 0.7;
  }

  /* Remove default markers in webkit browsers */
  .faq-accordion__question::-webkit-details-marker {
    display: none; 
  }

  .faq-accordion__icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: var(--fa-c-icon);
    transition: transform 0.2s ease;
  }

  /* Rotate icon when details is open */
  .faq-accordion__item[open] .faq-accordion__icon {
    transform: rotate(180deg);
  }

  .faq-accordion__answer {
    padding: 0 var(--fa-item-px-mo) var(--fa-item-py-mo) var(--fa-item-px-mo);
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-size: var(--fa-answer-size-mo);
    font-weight: 300;
    line-height: 1.7;
    color: var(--fa-c-answer);
  }

  .faq-accordion__answer p {
    margin: 0 0 1em;
    font: inherit;
    color: inherit;
  }

  .faq-accordion__answer p:last-child {
    margin-bottom: 0;
  }

  @media screen and (min-width: 750px) {
    .faq-accordion__question {
      padding: var(--fa-item-py-dk) var(--fa-item-px-dk);
      font-size: var(--fa-question-size-dk);
    }
    
    .faq-accordion__answer {
      padding: 0 var(--fa-item-px-dk) var(--fa-item-py-dk) var(--fa-item-px-dk);
      font-size: var(--fa-answer-size-dk);
    }
  }
{%- endstyle -%}

<div id="FaqAccordion-{{ section.id }}" class="faq-accordion section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <div class="faq-accordion__inner">
      
      {%- for block in section.blocks -%}
        <details class="faq-accordion__item" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary class="faq-accordion__question">
            <span>{{ block.settings.question | escape }}</span>
            <svg class="faq-accordion__icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m6 9 6 6 6-6"/>
            </svg>
          </summary>
          <div class="faq-accordion__answer rte">
            {{ block.settings.answer }}
          </div>
        </details>
      {%- endfor -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "FAQ Accordion",
  "tag": "section",
