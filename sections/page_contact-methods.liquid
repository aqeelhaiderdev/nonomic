{%- style -%}
  #ContactMethods-{{ section.id }} {
    --cm-bg: {{ section.settings.background_color }};
    --cm-content-max-width: {{ section.settings.content_max_width }}px;
    
    --cm-c-heading: {{ section.settings.color_heading }};
    --cm-c-link: {{ section.settings.color_link }};
    --cm-c-text: {{ section.settings.color_text }};

    /* Typography Variables (Mobile) */
    --cm-heading-size-mo: {{ section.settings.heading_size_mobile }}px;
    --cm-link-size-mo: {{ section.settings.link_size_mobile }}px;
    --cm-text-size-mo: {{ section.settings.text_size_mobile }}px;

    /* Typography Variables (Desktop) */
    --cm-heading-size-dk: {{ section.settings.heading_size_desktop }}px;
    --cm-link-size-dk: {{ section.settings.link_size_desktop }}px;
    --cm-text-size-dk: {{ section.settings.text_size_desktop }}px;

    /* Element Spacing Variables (Mobile) */
    --cm-grid-gap-mo: {{ section.settings.grid_gap_mobile }}px;
    --cm-heading-mb-mo: {{ section.settings.heading_margin_bottom_mobile }}px;
    --cm-text-mt-mo: {{ section.settings.text_margin_top_mobile }}px;

    /* Element Spacing Variables (Desktop) */
    --cm-grid-gap-dk: {{ section.settings.grid_gap_desktop }}px;
    --cm-heading-mb-dk: {{ section.settings.heading_margin_bottom_desktop }}px;
    --cm-text-mt-dk: {{ section.settings.text_margin_top_desktop }}px;

    background-color: var(--cm-bg);
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .contact-methods__inner {
    max-width: var(--cm-content-max-width);
    margin: 0 auto;
  }

  .contact-methods__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--cm-grid-gap-mo);
  }

  @media screen and (min-width: 750px) {
    .contact-methods__grid {
      grid-template-columns: repeat({{ section.blocks.size | at_most: 4 }}, 1fr);
      gap: var(--cm-grid-gap-dk);
    }
  }

  .contact-methods__item {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .contact-methods__heading {
    margin: 0 0 var(--cm-heading-mb-mo);
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-size: var(--cm-heading-size-mo);
    font-weight: 500;
    color: var(--cm-c-heading);
    line-height: 1.2;
  }

  .contact-methods__link {
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-size: var(--cm-link-size-mo);
    font-weight: 300;
    color: var(--cm-c-link);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .contact-methods__link:hover {
    opacity: 0.7;
  }

  .contact-methods__text {
    margin: var(--cm-text-mt-mo) 0 0;
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-size: var(--cm-text-size-mo);
    font-weight: 300;
    color: var(--cm-c-text);
    line-height: 1.6;
  }

  .contact-methods__text p {
    margin: 0;
    font: inherit;
    color: inherit;
  }

  @media screen and (min-width: 750px) {
    .contact-methods__heading {
      font-size: var(--cm-heading-size-dk);
      margin-bottom: var(--cm-heading-mb-dk);
    }

    .contact-methods__link {
      font-size: var(--cm-link-size-dk);
    }

    .contact-methods__text {
      font-size: var(--cm-text-size-dk);
      margin-top: var(--cm-text-mt-dk);
    }
  }
{%- endstyle -%}

<div id="ContactMethods-{{ section.id }}" class="contact-methods section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <div class="contact-methods__inner">
      
      {%- if section.blocks.size > 0 -%}
        <div class="contact-methods__grid">
          {%- for block in section.blocks -%}
            <div class="contact-methods__item" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h3 class="contact-methods__heading">{{ block.settings.heading | escape }}</h3>
              {%- endif -%}
              
              {%- if block.settings.link_text != blank -%}
                <a class="contact-methods__link" 
                   {% if block.settings.link_url == blank %}role="link" aria-disabled="true"{% else %}href="{{ block.settings.link_url }}"{% endif %}>
                  {{ block.settings.link_text | escape }}
                </a>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <div class="contact-methods__text rte">
                  {{ block.settings.text }}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact Methods",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout constraints"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 400,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Section max width",
      "default": 1280
    },
    {
      "type": "header",
      "content": "Typography (Desktop)"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Heading size",
      "default": 14
    },
    {
      "type": "range",
      "id": "link_size_desktop",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Link size",
      "default": 14
    },
    {
      "type": "range",
      "id": "text_size_desktop",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 12
    },
    {
      "type": "header",
      "content": "Typography (Mobile)"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Heading size",
      "default": 14
    },
    {
      "type": "range",
      "id": "link_size_mobile",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Link size",
      "default": 14
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 12
    },
    {
      "type": "header",
      "content": "Element Spacing (Desktop)"
    },
    {
      "type": "range",
      "id": "grid_gap_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Gap between columns",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_margin_bottom_desktop",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Heading bottom margin",
      "default": 8
    },
    {
      "type": "range",
      "id": "text_margin_top_desktop",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Description top margin",
      "default": 8
    },
    {
      "type": "header",
      "content": "Element Spacing (Mobile)"
    },
    {
      "type": "range",
      "id": "grid_gap_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Gap between columns",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_margin_bottom_mobile",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Heading bottom margin",
      "default": 8
    },
    {
      "type": "range",
      "id": "text_margin_top_mobile",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Description top margin",
      "default": 8
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "color_heading",
      "label": "Heading text",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "color_link",
      "label": "Link text",
      "default": "#1A2B3C"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Description text",
      "default": "#7A8899"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "contact_method",
      "name": "Contact Method",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Email"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link text",
          "default": "support@nonomic.com"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description",
          "default": "<p>Orders, returns, and general questions —<br>we respond within 24 hours.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact Methods",
      "blocks": [
        {
          "type": "contact_method",
          "settings": {
            "heading": "Email",
            "link_text": "support@nonomic.com",
            "link_url": "mailto:support@nonomic.com",
            "text": "<p>Orders, returns, and general questions —<br>we respond within 24 hours.</p>"
          }
        },
        {
          "type": "contact_method",
          "settings": {
            "heading": "Wholesale",
            "link_text": "wholesale@nonomic.com",
            "link_url": "mailto:wholesale@nonomic.com",
            "text": "<p>For retail inquiries</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}