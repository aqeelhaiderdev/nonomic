      "default": 48
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Horizontal padding mobile",
      "default": 16
    },
    {
      "type": "range",
      "id": "column_gap_desktop",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
