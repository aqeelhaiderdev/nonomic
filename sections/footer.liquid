      "content": "Social"
    },
    {
      "type": "checkbox",
      "id": "show_instagram",
      "label": "Show Instagram",
      "default": true
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "text",
      "id": "instagram_aria_label",
      "label": "Instagram accessible label",
      "default": "Instagram"
    },
    {
      "type": "checkbox",
      "id": "show_tiktok",
      "label": "Show TikTok",
      "default": true
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "text",
      "id": "tiktok_aria_label",
      "label": "TikTok accessible label",
      "default": "TikTok"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright line",
      "default": "© 2026 Nonomic. All rights reserved."
    },
    {
      "type": "url",
      "id": "privacy_link",
      "label": "Privacy policy URL"
    },
    {
      "type": "text",
      "id": "privacy_label",
      "label": "Privacy policy label",
      "default": "Privacy Policy"
    },
    {
      "type": "url",
      "id": "terms_link",
      "label": "Terms URL"
    },
    {
      "type": "text",
      "id": "terms_label",
      "label": "Terms label",
      "default": "Terms of Service"
    },
    {
      "type": "text",
