{{ 'section-nonomic-footer.css' | asset_url | stylesheet_tag }}
{%- if section.settings.payment_enable -%}
  {{ 'component-list-payment.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- liquid
  assign type_scale = section.settings.type_scale | divided_by: 100.0
  assign bottom_border_alpha = section.settings.bottom_border_opacity | divided_by: 100.0
  assign footer_form_id = 'NonomicFooterNewsletter-' | append: section.id
  assign nf_social_ig_ready = false
  if section.settings.show_instagram and section.settings.instagram_url != blank
    assign nf_social_ig_ready = true
  endif
  assign nf_social_tt_ready = false
  if section.settings.show_tiktok and section.settings.tiktok_url != blank
    assign nf_social_tt_ready = true
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --nf-bg: {{ section.settings.background_color }};
    --nf-text: {{ section.settings.text_color }};
    --nf-muted: {{ section.settings.muted_text_color }};
    --nf-border: {{ section.settings.border_color }};
    --nf-input-bg: {{ section.settings.input_background_color }};
    --nf-btn-top: {{ section.settings.button_gradient_start }};
    --nf-btn-bottom: {{ section.settings.button_gradient_end }};
    --nf-button-text: {{ section.settings.button_text_color }};
    --nf-bottom-border: {{ section.settings.bottom_border_color | color_modify: 'alpha', bottom_border_alpha }};
    --nf-max-width: {{ section.settings.max_width }}px;
    --nf-pad-x: {{ section.settings.padding_horizontal_desktop }}px;
    --nf-pad-x-mobile: {{ section.settings.padding_horizontal_mobile }}px;
    --nf-grid-gap-x: {{ section.settings.column_gap_desktop }}px;
    --nf-grid-gap-y: {{ section.settings.column_gap_desktop }}px;
    --nf-grid-gap-x-mobile: {{ section.settings.column_gap_mobile_x }}px;
    --nf-grid-gap-y-mobile: {{ section.settings.column_gap_mobile_y }}px;
    --nf-section-gap: {{ section.settings.section_gap_desktop }}px;
    --nf-section-gap-mobile: {{ section.settings.section_gap_mobile }}px;
    --nf-logo-h: {{ section.settings.logo_height }}px;
    --nf-type-scale: {{ type_scale }};
    --nf-bottom-justify: {{ section.settings.bottom_row_alignment }};
    --nf-bottom-gap: {{ section.settings.bottom_row_gap }}px;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .nonomic-footer__bottom {
      margin-top: var(--nf-section-gap-mobile);
    }
  }

  .footer--nonomic.section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .footer--nonomic.section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} .nonomic-footer {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .nonomic-footer {
      margin-top: {{ section.settings.margin_top }}px;
    }
  }
{%- endstyle -%}

<footer class="footer footer--nonomic nonomic-footer section-{{ section.id }}-padding">
  <div class="nonomic-footer__inner">
    <div class="nonomic-footer__layout">
      <div class="nonomic-footer__brand">
        {%- if section.settings.logo != blank -%}
          {%- liquid
            assign logo_alt = section.settings.logo.alt | default: shop.name | escape
            assign logo_class = 'nonomic-footer__logo'
            if section.settings.invert_logo
              assign logo_class = logo_class | append: ' nonomic-footer__logo--invert'
            endif
          -%}
          {%- capture logo_img -%}
            {{
              section.settings.logo
              | image_url: width: 600
              | image_tag:
                loading: 'lazy',
                class: logo_class,
                widths: '200, 400, 600',
                height: section.settings.logo_height,
                alt: logo_alt
            }}
          {%- endcapture -%}
          {%- if section.settings.logo_link != blank -%}
            <a href="{{ section.settings.logo_link }}" class="nonomic-footer__logo-link">{{ logo_img }}</a>
          {%- else -%}
            {{ logo_img }}
          {%- endif -%}
        {%- else -%}
          <a href="{{ routes.root_url }}" class="nonomic-footer__logo-link nonomic-footer__text-logo">{{ shop.name }}</a>
        {%- endif -%}

        {%- if section.settings.tagline != blank -%}
          <p class="nonomic-footer__tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}

        {%- if section.settings.newsletter_enable -%}
          <div class="nonomic-footer__newsletter-block">
            {%- if section.settings.newsletter_eyebrow != blank -%}
              <p class="nonomic-footer__newsletter-eyebrow">{{ section.settings.newsletter_eyebrow }}</p>
            {%- endif -%}
            {%- form 'customer', id: footer_form_id, class: 'nonomic-footer__newsletter-form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="nonomic-footer__newsletter-row">
                <label class="visually-hidden" for="NonomicFooterEmail-{{ section.id }}">{{ section.settings.newsletter_placeholder }}</label>
                <input
                  id="NonomicFooterEmail-{{ section.id }}"
                  type="email"
                  name="contact[email]"
                  class="nonomic-footer__input"
                  value="{{ form.email }}"
                  autocorrect="off"
                  autocapitalize="off"
                  autocomplete="email"
                  placeholder="{{ section.settings.newsletter_placeholder }}"
                  required
                  {% if form.errors %}
                    aria-invalid="true"
                    aria-describedby="NonomicFooter-error-{{ section.id }}"
                  {% elsif form.posted_successfully? %}
                    aria-describedby="NonomicFooter-success-{{ section.id }}"
                  {% endif %}
                >
                <button type="submit" class="nonomic-footer__submit" name="commit">
                  {{ section.settings.newsletter_button_label }}
                </button>
              </div>
              {%- if form.errors -%}
                <p class="nonomic-footer__form-message nonomic-footer__form-message--error" id="NonomicFooter-error-{{ section.id }}">
                  {{ form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email }}
                </p>
              {%- endif -%}
              {%- if form.posted_successfully? -%}
                <p class="nonomic-footer__form-message nonomic-footer__form-message--success" id="NonomicFooter-success-{{ section.id }}" tabindex="-1">
                  {{ section.settings.newsletter_success_message }}
                </p>
              {%- endif -%}
            {%- endform -%}
          </div>
        {%- endif -%}

        {%- if nf_social_ig_ready or nf_social_tt_ready -%}
          <ul class="nonomic-footer__social" role="list">
            {%- if nf_social_ig_ready -%}
              <li>
                <a
                  href="{{ section.settings.instagram_url }}"
                  class="nonomic-footer__social-link"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="{{ section.settings.instagram_aria_label }}"
                >
                  <svg class="nonomic-footer__social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                  </svg>
                </a>
              </li>
            {%- endif -%}
            {%- if nf_social_tt_ready -%}
              <li>
                <a
                  href="{{ section.settings.tiktok_url }}"
                  class="nonomic-footer__social-link"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="{{ section.settings.tiktok_aria_label }}"
                >
                  <svg class="nonomic-footer__social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
                  </svg>
                </a>
              </li>
            {%- endif -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="nonomic-footer__col nonomic-footer__col--product">
        {%- if section.settings.product_heading != blank -%}
          <h2 class="nonomic-footer__col-heading">{{ section.settings.product_heading }}</h2>
        {%- endif -%}
        {%- if section.settings.menu_product != blank -%}
          <ul class="nonomic-footer__nav" role="list">
            {%- for link in section.settings.menu_product.links -%}
              <li>
                <a href="{{ link.url }}" class="nonomic-footer__nav-link">{{ link.title }}</a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="nonomic-footer__col nonomic-footer__col--support">
        {%- if section.settings.support_heading != blank -%}
          <h2 class="nonomic-footer__col-heading">{{ section.settings.support_heading }}</h2>
        {%- endif -%}
        {%- if section.settings.menu_support != blank -%}
          <ul class="nonomic-footer__nav" role="list">
            {%- for link in section.settings.menu_support.links -%}
              <li>
                <a href="{{ link.url }}" class="nonomic-footer__nav-link">{{ link.title }}</a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="nonomic-footer__bottom">
        <div class="nonomic-footer__bottom-row">
          {%- if section.settings.copyright_text != blank -%}
            <div class="nonomic-footer__bottom-copy" >{{ section.settings.copyright_text }}
            <br>
            Designed and developed by <a href="https://www.vistarapid.com/" target="_blank" rel="noopener noreferrer" style="text-decoration: none;">VistaRapid.com</a>
            </div>
          {%- endif -%}

          {%- if section.settings.privacy_link != blank or section.settings.terms_link != blank -%}
            <div class="nonomic-footer__bottom-policies">
              {%- if section.settings.privacy_link != blank -%}
                <a href="{{ section.settings.privacy_link }}">{{ section.settings.privacy_label }}</a>
              {%- endif -%}
              {%- if section.settings.privacy_link != blank and section.settings.terms_link != blank -%}
                <span class="nonomic-footer__policy-sep">{{ section.settings.policy_separator }}</span>
              {%- endif -%}
              {%- if section.settings.terms_link != blank -%}
                <a href="{{ section.settings.terms_link }}">{{ section.settings.terms_label }}</a>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if section.settings.show_powered_row -%}
            <div class="nonomic-footer__bottom-powered">
              {%- if section.settings.show_powered_icon -%}
                <svg class="nonomic-footer__powered-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                  <text x="12" y="16" font-size="12" fill="currentColor" text-anchor="middle" font-weight="600">Ag</text>
                </svg>
              {%- endif -%}
              {%- if section.settings.powered_text != blank -%}
                <span>{{ section.settings.powered_text }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

        {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
          <div class="nonomic-footer__localization nonomic-footer__localization--spaced">
            <localization-form>
              {%- form 'localization', id: 'FooterCountryForm', class: 'localization-form' -%}
                <div>
                  <h2 class="caption-large" id="FooterCountryLabel">{{ 'localization.country_label' | t }}</h2>
                  {%- render 'country-localization', localPosition: 'FooterCountry' -%}
                </div>
              {%- endform -%}
            </localization-form>
          </div>
        {%- endif -%}

        {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
          <div class="nonomic-footer__localization nonomic-footer__localization--spaced-tight">
            <localization-form>
              {%- form 'localization', id: 'FooterLanguageForm', class: 'localization-form' -%}
                <div>
                  <h2 class="caption-large" id="FooterLanguageLabel">{{ 'localization.language_label' | t }}</h2>
                  {%- render 'language-localization', localPosition: 'FooterLanguage' -%}
                </div>
              {%- endform -%}
            </localization-form>
          </div>
        {%- endif -%}

        {%- if section.settings.payment_enable -%}
          <div class="nonomic-footer__payments nonomic-footer__localization--spaced">
            <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
            <ul class="list list-payment" role="list">
              {%- for type in shop.enabled_payment_types -%}
                <li class="list-payment__item">
                  {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "section-footer",
  "settings": [
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "type_scale",
      "min": 80,
      "max": 120,
      "step": 1,
      "unit": "%",
      "label": "Text size scale",
      "default": 100,
      "info": "Scales text relative to theme body font scale."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Primary text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Muted text",
      "default": "#7A8899"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Borders",
      "default": "#DDE1E8"
    },
    {
      "type": "color",
      "id": "input_background_color",
      "label": "Email field background",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "button_gradient_start",
      "label": "Button gradient top",
      "default": "#1BA97A"
    },
    {
      "type": "color",
      "id": "button_gradient_end",
      "label": "Button gradient bottom",
      "default": "#178A64"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "bottom_border_color",
      "label": "Bottom divider",
      "default": "#DDE1E8"
    },
    {
      "type": "range",
      "id": "bottom_border_opacity",
      "min": 5,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Bottom divider opacity",
      "default": 10
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "logo_link",
      "label": "Logo link"
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 16,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Logo height",
      "default": 28
    },
    {
      "type": "checkbox",
      "id": "invert_logo",
      "label": "Invert logo colors",
      "default": true
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "The first deodorant built around a mechanism, not a marketing claim."
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "label": "Show newsletter",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_eyebrow",
      "label": "Heading",
      "default": "Early access. No noise."
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Email placeholder",
      "default": "your@email.com"
    },
    {
      "type": "text",
      "id": "newsletter_button_label",
      "label": "Button label",
      "default": "Join →"
    },
    {
      "type": "text",
      "id": "newsletter_success_message",
      "label": "Success message",
      "default": "Thanks for subscribing."
    },
    {
      "type": "header",
      "content": "Menus"
    },
    {
      "type": "text",
      "id": "product_heading",
      "label": "First column heading",
      "default": "The Product"
    },
    {
      "type": "link_list",
      "id": "menu_product",
      "label": "First column menu"
    },
    {
      "type": "text",
      "id": "support_heading",
      "label": "Second column heading",
      "default": "Support"
    },
    {
      "type": "link_list",
      "id": "menu_support",
