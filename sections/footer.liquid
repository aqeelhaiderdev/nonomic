      "default": 48
    },
    {
      "type": "range",
      "id": "column_gap_mobile_x",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Column gap mobile horizontal",
      "default": 16
    },
    {
      "type": "range",
      "id": "column_gap_mobile_y",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Column gap mobile vertical",
