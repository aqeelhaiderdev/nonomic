    },
    {
      "type": "range",
      "id": "section_gap_desktop",
      "min": 24,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Space above bottom bar desktop",
      "default": 48
    },
    {
      "type": "range",
      "id": "section_gap_mobile",
      "min": 16,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Space above bottom bar mobile",
      "default": 32
    },
    {
      "type": "header",
      "content": "Optional Dawn features"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "label": "Country selector",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "label": "Language selector",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "label": "Payment icons",
      "default": false
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding top mobile",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
