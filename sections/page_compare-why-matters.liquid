{%- style -%}
  #WhyItMatters-{{ section.id }} {
    --wim-bg: {{ section.settings.background_color }};
    --wim-content-max-width: {{ section.settings.content_max_width }}px;
    
    --wim-c-heading: {{ section.settings.color_heading }};
    --wim-c-item-title: {{ section.settings.color_item_title }};
    --wim-c-prob-label: {{ section.settings.color_problem_label }};
    --wim-c-prob-text: {{ section.settings.color_problem_text }};
    --wim-c-sol-label: {{ section.settings.color_solution_label }};
    --wim-c-sol-text: {{ section.settings.color_solution_text }};

    /* Typography Variables (Mobile) */
    --wim-heading-size-mo: {{ section.settings.heading_size_mobile }}px;
    --wim-item-title-size-mo: {{ section.settings.item_title_size_mobile }}px;
    --wim-label-size-mo: {{ section.settings.label_size_mobile }}px;
    --wim-text-size-mo: {{ section.settings.text_size_mobile }}px;

    /* Typography Variables (Desktop) */
    --wim-heading-size-dk: {{ section.settings.heading_size_desktop }}px;
    --wim-item-title-size-dk: {{ section.settings.item_title_size_desktop }}px;
    --wim-label-size-dk: {{ section.settings.label_size_desktop }}px;
    --wim-text-size-dk: {{ section.settings.text_size_desktop }}px;

    /* Element Spacing Variables (Mobile) */
    --wim-heading-pb-mo: {{ section.settings.heading_padding_bottom_mobile }}px;
    --wim-grid-gap-mo: {{ section.settings.grid_gap_mobile }}px;

    /* Element Spacing Variables (Desktop) */
    --wim-heading-pb-dk: {{ section.settings.heading_padding_bottom_desktop }}px;
    --wim-grid-gap-dk: {{ section.settings.grid_gap_desktop }}px;

    background-color: var(--wim-bg);
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .why-matters__inner {
    max-width: var(--wim-content-max-width);
    margin: 0 auto;
  }

  .why-matters__heading {
    margin: 0 0 var(--wim-heading-pb-mo);
    text-align: center;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-size: var(--wim-heading-size-mo);
    font-weight: 400;
    line-height: 1.2;
    color: var(--wim-c-heading);
  }

  .why-matters__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--wim-grid-gap-mo);
  }

  @media screen and (min-width: 750px) {
    .why-matters__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--wim-grid-gap-dk);
    }
  }

  .why-matters__item {
    display: flex;
    flex-direction: column;
  }

  .why-matters__item-title {
    margin: 0 0 12px;
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-size: var(--wim-item-title-size-mo);
    font-weight: 500;
    color: var(--wim-c-item-title);
    line-height: 1.3;
  }

  .why-matters__label--problem {
    margin: 0 0 8px;
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-size: var(--wim-label-size-mo);
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--wim-c-prob-label);
  }

  .why-matters__text--problem {
    margin: 0 0 16px;
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-size: var(--wim-text-size-mo);
    font-weight: 300;
    line-height: 1.7;
    color: var(--wim-c-prob-text);
  }

  .why-matters__text--problem p {
    margin: 0;
    font: inherit;
    color: inherit;
  }

  .why-matters__label--solution {
    margin: 0 0 8px;
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-size: var(--wim-label-size-mo);
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--wim-c-sol-label);
  }

  .why-matters__text--solution {
    margin: 0;
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-size: var(--wim-text-size-mo);
    font-weight: 300;
    line-height: 1.7;
    color: var(--wim-c-sol-text);
  }

  .why-matters__text--solution p {
    margin: 0;
    font: inherit;
    color: inherit;
  }

  @media screen and (min-width: 750px) {
    .why-matters__heading {
      font-size: var(--wim-heading-size-dk);
      margin-bottom: var(--wim-heading-pb-dk);
    }

    .why-matters__item-title {
      font-size: var(--wim-item-title-size-dk);
    }

    .why-matters__label--problem,
    .why-matters__label--solution {
      font-size: var(--wim-label-size-dk);
    }

    .why-matters__text--problem,
    .why-matters__text--solution {
      font-size: var(--wim-text-size-dk);
    }
  }
{%- endstyle -%}

<div id="WhyItMatters-{{ section.id }}" class="why-matters section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <div class="why-matters__inner">
      
      {%- if section.settings.heading != blank -%}
        <h2 class="why-matters__heading">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="why-matters__grid">
          {%- for block in section.blocks -%}
            <div class="why-matters__item" {{ block.shopify_attributes }}>
              
              {%- if block.settings.title != blank -%}
                <h3 class="why-matters__item-title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              
              {%- if block.settings.problem_label != blank -%}
                <div class="why-matters__label--problem">{{ block.settings.problem_label | escape }}</div>
              {%- endif -%}

              {%- if block.settings.problem_text != blank -%}
                <div class="why-matters__text--problem rte">{{ block.settings.problem_text }}</div>
              {%- endif -%}

              {%- if block.settings.solution_label != blank -%}
                <div class="why-matters__label--solution">{{ block.settings.solution_label | escape }}</div>
              {%- endif -%}

              {%- if block.settings.solution_text != blank -%}
                <div class="why-matters__text--solution rte">{{ block.settings.solution_text }}</div>
              {%- endif -%}

            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Why It Matters",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why It Matters"
    },
    {
      "type": "header",
      "content": "Layout constraints"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 400,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Content max width",
      "default": 1280
    },
    {
      "type": "header",
      "content": "Typography (Desktop)"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 40
    },
    {
      "type": "range",
      "id": "item_title_size_desktop",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Block Title size",
      "default": 16
    },
    {
      "type": "range",
      "id": "label_size_desktop",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subheading size",
      "default": 11
    },
    {
      "type": "range",
      "id": "text_size_desktop",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Body Text size",
      "default": 14
    },
    {
      "type": "header",
      "content": "Typography (Mobile)"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 32
    },
    {
      "type": "range",
      "id": "item_title_size_mobile",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Block Title size",
      "default": 16
    },
    {
      "type": "range",
      "id": "label_size_mobile",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subheading size",
      "default": 11
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Body Text size",
      "default": 14
    },
    {
      "type": "header",
      "content": "Element Spacing (Desktop)"
    },
    {
      "type": "range",
      "id": "heading_padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading bottom padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "grid_gap_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Gap between columns",
      "default": 32
    },
    {
      "type": "header",
      "content": "Element Spacing (Mobile)"
    },
    {
      "type": "range",
      "id": "heading_padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading bottom padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "grid_gap_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Gap between columns",
      "default": 32
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "color_heading",
      "label": "Main Heading",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "color_item_title",
      "label": "Block Title",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "color_problem_label",
      "label": "Problem Subheading",
      "default": "#7A8899"
    },
    {
      "type": "color",
      "id": "color_problem_text",
      "label": "Problem Text",
      "default": "#4B5A6B"
    },
    {
      "type": "color",
      "id": "color_solution_label",
      "label": "Solution Subheading",
      "default": "#1A2B3C"
    },
    {
      "type": "color",
      "id": "color_solution_text",
      "label": "Solution Text",
      "default": "#4B5A6B"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "comparison_item",
      "name": "Comparison Item",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Natural Deodorants"
        },
        {
          "type": "text",
          "id": "problem_label",
          "label": "Problem Label",
          "default": "THE PROBLEM"
        },
        {
          "type": "richtext",
          "id": "problem_text",
          "label": "Problem Text",
          "default": "<p>Often rely on baking soda, which causes irritation in 60%+ of users. Require frequent reapplication. Inconsistent performance.</p>"
        },
        {
          "type": "text",
          "id": "solution_label",
          "label": "Solution Label",
          "default": "NONOMIC'S APPROACH"
        },
        {
          "type": "richtext",
          "id": "solution_text",
          "label": "Solution Text",
          "default": "<p>Nonomic uses magnesium hydroxide + MicroSilver for irritation-free, all-day protection.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why It Matters",
      "blocks": [
        {
          "type": "comparison_item",
          "settings": {
            "title": "Natural Deodorants",
            "problem_label": "THE PROBLEM",
            "problem_text": "<p>Often rely on baking soda, which causes irritation in 60%+ of users. Require frequent reapplication. Inconsistent performance.</p>",
            "solution_label": "NONOMIC'S APPROACH",
            "solution_text": "<p>Nonomic uses magnesium hydroxide + MicroSilver for irritation-free, all-day protection.</p>"
          }
        },
        {
          "type": "comparison_item",
          "settings": {
            "title": "Antiperspirants",
            "problem_label": "THE PROBLEM",
            "problem_text": "<p>Block sweat ducts with aluminum. Many users prefer not to interfere with natural perspiration. Can cause buildup and staining.</p>",
            "solution_label": "NONOMIC'S APPROACH",
            "solution_text": "<p>Nonomic allows natural sweating while neutralizing odor-causing bacteria.</p>"
          }
        },
        {
          "type": "comparison_item",
          "settings": {
            "title": "Fragrance Masking",
            "problem_label": "THE PROBLEM",
            "problem_text": "<p>Covers odor instead of preventing it. Creates layered scent issues. Doesn't address the bacterial cause.</p>",
            "solution_label": "NONOMIC'S APPROACH",
            "solution_text": "<p>Nonomic disrupts bacteria at the source. Scents are optional, not required.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}