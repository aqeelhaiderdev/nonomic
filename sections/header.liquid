{{ 'section-nonomic-header.css' | asset_url | stylesheet_tag }}
{%- if request.page_type == 'index' -%}
  <script src="{{ 'nonomic-header-scroll.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
<link
  rel="stylesheet"
  href="{{ 'component-cart-notification.css' | asset_url }}"
  media="print"
  onload="this.media='all'"
>

{%- liquid
  assign border_alpha = section.settings.border_opacity | divided_by: 100.0
  assign mobile_divider_alpha = section.settings.mobile_divider_opacity | divided_by: 100.0
  assign mobile_chevron_alpha = section.settings.mobile_chevron_opacity | divided_by: 100.0
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --nonomic-header-bg: {{ section.settings.background_color }};
    --nonomic-header-text: {{ section.settings.text_color }};
    --nonomic-header-border-width: {% if section.settings.show_line_separator %}0.05rem{% else %}0{% endif %};
    --nonomic-header-border-color: {{ section.settings.border_color | color_modify: 'alpha', border_alpha }};
    --nonomic-header-page-width: {{ section.settings.page_width }}px;
    --nonomic-header-height: {{ section.settings.desktop_height }}px;
    --nonomic-header-mobile-height: {{ section.settings.mobile_height }}px;
    --nonomic-header-padding-x: {{ section.settings.desktop_padding_x }}px;
    --nonomic-header-padding-y: {{ section.settings.desktop_padding_y }}px;
    --nonomic-header-mobile-padding-x: {{ section.settings.mobile_padding_x }}px;
    --nonomic-header-mobile-padding-y: {{ section.settings.mobile_padding_y }}px;
    --nonomic-header-logo-width: {{ section.settings.logo_width }}px;
    --nonomic-header-mobile-logo-width: {{ section.settings.mobile_logo_width }}px;
    --nonomic-header-logo-height: {{ section.settings.logo_height }}px;
    --nonomic-header-link-gap: {{ section.settings.desktop_link_gap }}px;
    --nonomic-header-link-size: {{ section.settings.desktop_link_font_size }};
    --nonomic-header-button-height: {{ section.settings.desktop_button_height }}px;
    --nonomic-header-button-padding-x: {{ section.settings.desktop_button_padding_x }}px;
    --nonomic-header-button-radius: {{ section.settings.desktop_button_radius }}px;
    --nonomic-header-button-size: {{ section.settings.desktop_button_font_size }};
    --nonomic-header-mobile-button-height: {{ section.settings.mobile_button_height }}px;
    --nonomic-header-mobile-button-radius: {{ section.settings.mobile_button_radius }}px;
    --nonomic-header-mobile-button-size: {{ section.settings.mobile_button_font_size }};
    --nonomic-header-button-bg-start: {{ section.settings.button_gradient_start }};
    --nonomic-header-button-bg-end: {{ section.settings.button_gradient_end }};
    --nonomic-header-button-text: {{ section.settings.button_text_color }};
    --nonomic-header-cart-count-bg: {{ section.settings.cart_count_background }};
    --nonomic-header-cart-count-text: {{ section.settings.cart_count_text }};
    --nonomic-header-mobile-bg-start: {{ section.settings.mobile_background_start }};
    --nonomic-header-mobile-bg-mid: {{ section.settings.mobile_background_mid }};
    --nonomic-header-mobile-bg-deep: {{ section.settings.mobile_background_deep }};
    --nonomic-header-mobile-bg-end: {{ section.settings.mobile_background_end }};
    --nonomic-header-trust-size: {{ section.settings.mobile_trust_font_size }};
    --nonomic-header-trust-text: {{ section.settings.mobile_trust_text_color }};
    --nonomic-header-trust-muted: {{ section.settings.mobile_trust_muted_color }};
    --nonomic-header-mobile-divider: {{ section.settings.mobile_divider_color | color_modify: 'alpha', mobile_divider_alpha }};
    --nonomic-header-mobile-link-size: {{ section.settings.mobile_link_font_size }};
    --nonomic-header-mobile-link-gap: {{ section.settings.mobile_link_gap }}px;
    --nonomic-header-mobile-chevron: {{ section.settings.mobile_chevron_color | color_modify: 'alpha', mobile_chevron_alpha }};
  }

  .section-header {
    position: sticky;
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-header {
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }
  }

{%- endstyle -%}

<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>

{% liquid
  assign header_tag = 'div'

  if section.settings.sticky_header_type != 'none'
    assign header_tag = 'sticky-header'
  endif
%}

<{{ header_tag }}
  {% if header_tag == 'sticky-header' %}
    data-sticky-type="{{ section.settings.sticky_header_type }}"
  {% endif %}
  {% if request.page_type == 'index' %}
    data-nonomic-homepage-header
  {% endif %}
  class="nonomic-header-wrapper"
>
  {%- liquid
    assign header_logo = section.settings.logo_image | default: settings.logo
    assign mobile_logo = section.settings.mobile_logo_image | default: header_logo
    assign mobile_menu = section.settings.mobile_menu
    assign cta_url = section.settings.cta_link | default: '#formula'

    if mobile_menu == blank
      assign mobile_menu = section.settings.menu
    endif
  -%}

  <header class="nonomic-header page-width">
    {%- if request.page_type == 'index' -%}
      <h1 class="nonomic-header__heading">
    {%- else -%}
      <div class="nonomic-header__heading">
    {%- endif -%}
      <a href="{{ routes.root_url }}" class="nonomic-header__heading-link focus-inset">
        {%- if header_logo != blank -%}
          {%- assign logo_alt = header_logo.alt | default: shop.name | escape -%}
          {% capture logo_sizes %}(max-width: 768px) {{ section.settings.mobile_logo_width }}px, {{ section.settings.logo_width }}px{% endcapture %}
          {% capture logo_widths %}{{ section.settings.mobile_logo_width }}, {{ section.settings.logo_width }}, {{ section.settings.logo_width | times: 2 }}{% endcapture %}
          {{
            header_logo
            | image_url: width: 600
            | image_tag:
              class: 'nonomic-header__logo motion-reduce',
              widths: logo_widths,
              width: section.settings.logo_width,
              alt: logo_alt,
              sizes: logo_sizes,
              preload: true
          }}
        {%- else -%}
          <span class="nonomic-header__shop-name h2">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    {%- if request.page_type == 'index' -%}
      </h1>
    {%- else -%}
      </div>
    {%- endif -%}

    {%- if section.settings.menu != blank -%}
      <nav class="nonomic-header__nav" aria-label="{{ 'sections.header.menu' | t }}">
        <ul class="nonomic-header__menu" role="list">
          {%- for link in section.settings.menu.links -%}
            <li>
              <a
                id="NonomicHeaderMenu-{{ link.handle }}"
                href="{{ link.url }}"
                class="nonomic-header__link focus-inset{% if link.current or link.child_active %} is-active{% endif %}"
                {% if link.current %}
                  aria-current="page"
                {% endif %}
              >
                {{ link.title | escape }}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    {%- if request.page_type == 'index' and section.settings.sticky_guarantee_text != blank -%}
      <div class="nonomic-header__guarantee" aria-hidden="true">
        <span class="nonomic-header__guarantee-icon">
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
            <path d="M10 1.5 3.5 4v5.2c0 4.1 2.8 7.9 6.5 9.3 3.7-1.4 6.5-5.2 6.5-9.3V4L10 1.5Z" fill="currentColor"/>
            <path d="m7.2 10.1 1.6 1.6 3.8-3.8" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="nonomic-header__guarantee-text">{{ section.settings.sticky_guarantee_text | escape }}</span>
      </div>
    {%- endif -%}

    <div class="nonomic-header__actions">
      <details class="nonomic-mobile-menu">
        <summary class="nonomic-mobile-menu__summary focus-inset" aria-label="{{ section.settings.mobile_menu_label | escape }}">
          <span class="nonomic-mobile-menu__icon-open svg-wrapper">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
              <line x1="4" x2="20" y1="12" y2="12"></line>
              <line x1="4" x2="20" y1="6" y2="6"></line>
              <line x1="4" x2="20" y1="18" y2="18"></line>
            </svg>
          </span>
          <span class="nonomic-mobile-menu__icon-close svg-wrapper">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
              <path d="M18 6 6 18"></path>
              <path d="m6 6 12 12"></path>
            </svg>
          </span>
        </summary>

        <div class="nonomic-mobile-menu__panel">
          <div class="nonomic-mobile-menu__top">
            {%- if mobile_logo != blank -%}
              {%- assign mobile_logo_alt = mobile_logo.alt | default: shop.name | escape -%}
              {% capture mobile_logo_sizes %}{{ section.settings.mobile_logo_width }}px{% endcapture %}
              {{
                mobile_logo
                | image_url: width: 500
                | image_tag:
                  class: 'nonomic-mobile-menu__logo motion-reduce',
                  widths: logo_widths,
                  width: section.settings.mobile_logo_width,
                  alt: mobile_logo_alt,
                  sizes: mobile_logo_sizes
              }}
            {%- else -%}
              <span class="nonomic-header__shop-name h2">{{ shop.name }}</span>
            {%- endif -%}
          </div>

          {%- if section.settings.cta_text != blank and cta_url != blank -%}
            <a href="{{ cta_url }}" class="nonomic-header__cta focus-inset">
              {{ section.settings.cta_text | escape }}
            </a>
          {%- endif -%}

          {%- if section.settings.mobile_trust_text != blank or section.settings.mobile_trust_muted_text != blank -%}
            <p class="nonomic-mobile-menu__trust">
              {%- if section.settings.mobile_trust_text != blank -%}
                <span class="nonomic-mobile-menu__trust-strong">{{ section.settings.mobile_trust_text | escape }}</span>
              {%- endif -%}
              {%- if section.settings.mobile_trust_muted_text != blank -%}
                {{ section.settings.mobile_trust_muted_text | escape }}
              {%- endif -%}
            </p>
          {%- endif -%}

          <div class="nonomic-mobile-menu__divider" aria-hidden="true"></div>

          {%- if mobile_menu != blank -%}
            <nav aria-label="{{ section.settings.mobile_menu_label | escape }}">
              <ul class="nonomic-mobile-menu__list" role="list">
                {%- for link in mobile_menu.links -%}
                  <li>
                    <a
                      id="NonomicMobileMenu-{{ link.handle }}"
                      href="{{ link.url }}"
                      class="nonomic-mobile-menu__link focus-inset{% if link.current or link.child_active %} is-active{% endif %}"
                      {% if link.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      <span>{{ link.title | escape }}</span>
                      <svg class="nonomic-mobile-menu__chevron" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                        <path d="M7.5 4.5 12.5 10l-5 5.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            </nav>
          {%- endif -%}
        </div>
      </details>

      <a href="{{ routes.cart_url }}" class="nonomic-header__cart focus-inset" id="cart-icon-bubble">
        <span class="svg-wrapper">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
            <path d="M3 6h18"></path>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
        </span>
        <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
        {%- if cart != empty -%}
          <div class="cart-count-bubble">
            {%- if cart.item_count < 100 -%}
              <span aria-hidden="true">{{ cart.item_count }}</span>
            {%- endif -%}
            <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
          </div>
        {%- endif -%}
      </a>

      {%- if section.settings.cta_text != blank and cta_url != blank -%}
        <a href="{{ cta_url }}" class="nonomic-header__cta focus-inset">
          {{ section.settings.cta_text | escape }}
        </a>
      {%- endif -%}

    </div>
  </header>
</{{ header_tag }}>

{%- if settings.cart_type == 'notification' -%}
  {%- render 'cart-notification',
    color_scheme: section.settings.color_scheme,
    desktop_menu_type: 'dropdown'
  -%}
{%- endif -%}

{% javascript %}
  class StickyHeader extends HTMLElement {
    constructor() {
      super();
    }

    connectedCallback() {
      this.header = document.querySelector('.section-header');
      this.headerIsAlwaysSticky =
        this.getAttribute('data-sticky-type') === 'always' ||
        this.getAttribute('data-sticky-type') === 'reduce-logo-size';
      this.headerBounds = {};

      this.setHeaderHeight();

      window.matchMedia('(max-width: 768px)').addEventListener('change', this.setHeaderHeight.bind(this));

      if (this.headerIsAlwaysSticky) {
        this.header.classList.add('shopify-section-header-sticky');
      }

      this.currentScrollTop = 0;
      this.preventReveal = false;
      this.predictiveSearch = this.querySelector('predictive-search');

      this.onScrollHandler = this.onScroll.bind(this);
      this.hideHeaderOnScrollUp = () => (this.preventReveal = true);

      this.addEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.addEventListener('scroll', this.onScrollHandler, false);

      this.createObserver();
    }

    setHeaderHeight() {
      document.documentElement.style.setProperty('--header-height', `${this.header.offsetHeight}px`);
    }

    disconnectedCallback() {
      this.removeEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.removeEventListener('scroll', this.onScrollHandler);
    }

    createObserver() {
      let observer = new IntersectionObserver((entries, observer) => {
        this.headerBounds = entries[0].intersectionRect;
        observer.disconnect();
      });

      observer.observe(this.header);
    }

    onScroll() {
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

      if (this.predictiveSearch && this.predictiveSearch.isOpen) return;

      if (this.hasAttribute('data-nonomic-homepage-header')) {
        if (this.classList.contains('is-header-suppressed')) {
          requestAnimationFrame(this.hide.bind(this));
          this.currentScrollTop = scrollTop;
          return;
        }

        if (this.classList.contains('is-scroll-cta-active')) {
          if (scrollTop > this.headerBounds.bottom) {
            this.header.classList.add('scrolled-past-header');
            requestAnimationFrame(this.reveal.bind(this));
          } else if (scrollTop <= this.headerBounds.top) {
            this.header.classList.remove('scrolled-past-header');
            requestAnimationFrame(this.reset.bind(this));
          }
          this.currentScrollTop = scrollTop;
          return;
        }
      }

      if (scrollTop > this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        if (this.preventHide) return;
        requestAnimationFrame(this.hide.bind(this));
      } else if (scrollTop < this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        if (!this.preventReveal) {
          requestAnimationFrame(this.reveal.bind(this));
        } else {
          window.clearTimeout(this.isScrolling);

          this.isScrolling = setTimeout(() => {
            this.preventReveal = false;
          }, 66);

          requestAnimationFrame(this.hide.bind(this));
        }
      } else if (scrollTop <= this.headerBounds.top) {
        this.header.classList.remove('scrolled-past-header');
        requestAnimationFrame(this.reset.bind(this));
      }

      this.currentScrollTop = scrollTop;
    }

    hide() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.add('shopify-section-header-hidden', 'shopify-section-header-sticky', 'animate');
      this.closeMenuDisclosure();
      this.closeSearchModal();
    }

    reveal() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.add('shopify-section-header-sticky', 'animate');
      this.header.classList.remove('shopify-section-header-hidden');
    }

    reset() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.remove('shopify-section-header-hidden', 'shopify-section-header-sticky', 'animate');
    }

    closeMenuDisclosure() {
      this.disclosures = this.disclosures || this.header.querySelectorAll('header-menu');
      this.disclosures.forEach((disclosure) => disclosure.close());
    }

    closeSearchModal() {
      this.searchModal = this.searchModal || this.header.querySelector('details-modal');
      if (!this.searchModal) return;

      this.searchModal.close(false);
    }
  }

  customElements.define('sticky-header', StickyHeader);
{% endjavascript %}

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
      {{ settings.social_twitter_link | json }},
      {{ settings.social_facebook_link | json }},
      {{ settings.social_pinterest_link | json }},
      {{ settings.social_instagram_link | json }},
      {{ settings.social_tiktok_link | json }},
      {{ settings.social_tumblr_link | json }},
      {{ settings.social_snapchat_link | json }},
      {{ settings.social_youtube_link | json }},
      {{ settings.social_vimeo_link | json }}
    ],
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = request.origin | append: routes.search_url | append: '?q={search_term_string}' %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.header.name",
  "class": "section-header",
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo override",
      "info": "Uses the global theme logo when blank."
    },
    {
      "type": "image_picker",
      "id": "mobile_logo_image",
      "label": "Mobile menu logo override",
      "info": "Uses the header logo when blank."
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 260,
      "step": 5,
      "unit": "px",
      "label": "Desktop logo width",
      "default": 130
    },
    {
      "type": "range",
      "id": "mobile_logo_width",
      "min": 80,
      "max": 220,
      "step": 5,
      "unit": "px",
      "label": "Mobile logo width",
      "default": 130
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 20,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Logo max height",
      "default": 28
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Desktop menu"
    },
    {
      "type": "link_list",
      "id": "mobile_menu",
      "default": "main-menu",
      "label": "Mobile menu"
    },
    {
      "type": "text",
      "id": "mobile_menu_label",
      "label": "Mobile menu accessibility label",
      "default": "Menu"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "Choose Your Formula →"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Homepage scroll header"
    },
    {
      "type": "text",
      "id": "sticky_guarantee_text",
      "label": "Desktop guarantee text (after hero)",
      "default": "45-day risk-free guarantee"
    },
    {
      "type": "text",
      "id": "mobile_trust_text",
      "label": "Mobile trust text",
      "default": "★★★★★ 4.8 rating"
    },
    {
      "type": "text",
      "id": "mobile_trust_muted_text",
      "label": "Mobile muted trust text",
      "default": " · 45-day risk-free"
    },
    {
      "type": "select",
      "id": "sticky_header_type",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "on-scroll-up",
          "label": "On scroll up"
        },
        {
          "value": "always",
          "label": "Always"
        },
        {
          "value": "reduce-logo-size",
          "label": "Always, reduce logo size"
        }
      ],
      "default": "on-scroll-up",
      "label": "Sticky header"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Cart notification color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Header background",
      "default": "#1A2B3C"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Header text",
      "default": "#FFFFFF"
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "default": true,
      "label": "Show separator"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Separator color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Separator opacity",
      "default": 10
    },
    {
      "type": "color",
      "id": "button_gradient_start",
      "label": "Button gradient top",
      "default": "#1BA97A"
    },
    {
      "type": "color",
      "id": "button_gradient_end",
      "label": "Button gradient bottom",
      "default": "#178A64"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "cart_count_background",
      "label": "Cart count background",
      "default": "#1D9E75"
    },
    {
      "type": "color",
      "id": "cart_count_text",
      "label": "Cart count text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Mobile menu colors"
    },
    {
      "type": "color",
      "id": "mobile_background_start",
      "label": "Gradient start",
      "default": "#0E3040"
    },
    {
      "type": "color",
      "id": "mobile_background_mid",
      "label": "Gradient middle",
      "default": "#0A2330"
    },
    {
      "type": "color",
      "id": "mobile_background_deep",
      "label": "Gradient deep",
      "default": "#061820"
    },
    {
