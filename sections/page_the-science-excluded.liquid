{%- style -%}
  #ScienceExcluded-{{ section.id }} {
    --se-bg: {{ section.settings.background_color }};
    --se-content-max-width: {{ section.settings.content_max_width }}px;
    
    --se-c-heading: {{ section.settings.color_heading }};
    --se-c-card-bg: {{ section.settings.color_card_bg }};
    --se-c-card-border: {{ section.settings.color_card_border }};
    --se-c-card-name: {{ section.settings.color_card_name }};
    --se-c-card-text: {{ section.settings.color_card_text }};

    /* Typography Variables (Mobile) */
    --se-heading-size-mo: {{ section.settings.heading_size_mobile }}px;
    --se-card-name-size-mo: {{ section.settings.card_name_size_mobile }}px;
    --se-card-text-size-mo: {{ section.settings.card_text_size_mobile }}px;

    /* Typography Variables (Desktop) */
    --se-heading-size-dk: {{ section.settings.heading_size_desktop }}px;
    --se-card-name-size-dk: {{ section.settings.card_name_size_desktop }}px;
    --se-card-text-size-dk: {{ section.settings.card_text_size_desktop }}px;

    /* Element Spacing Variables (Mobile) */
    --se-heading-pt-mo: {{ section.settings.heading_padding_top_mobile }}px;
    --se-heading-pb-mo: {{ section.settings.heading_padding_bottom_mobile }}px;
    --se-grid-pt-mo: {{ section.settings.grid_padding_top_mobile }}px;
    --se-grid-pb-mo: {{ section.settings.grid_padding_bottom_mobile }}px;
    --se-grid-gap-mo: {{ section.settings.grid_gap_mobile }}px;
    --se-card-pt-mo: {{ section.settings.card_padding_top_mobile }}px;
    --se-card-pb-mo: {{ section.settings.card_padding_bottom_mobile }}px;
    --se-card-px-mo: {{ section.settings.card_padding_horizontal_mobile }}px;

    /* Element Spacing Variables (Desktop) */
    --se-heading-pt-dk: {{ section.settings.heading_padding_top_desktop }}px;
    --se-heading-pb-dk: {{ section.settings.heading_padding_bottom_desktop }}px;
    --se-grid-pt-dk: {{ section.settings.grid_padding_top_desktop }}px;
    --se-grid-pb-dk: {{ section.settings.grid_padding_bottom_desktop }}px;
    --se-grid-gap-dk: {{ section.settings.grid_gap_desktop }}px;
    --se-card-pt-dk: {{ section.settings.card_padding_top_desktop }}px;
    --se-card-pb-dk: {{ section.settings.card_padding_bottom_desktop }}px;
    --se-card-px-dk: {{ section.settings.card_padding_horizontal_desktop }}px;

    background-color: var(--se-bg);
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .science-excluded__inner {
    max-width: var(--se-content-max-width);
    margin: 0 auto;
  }

  .science-excluded__heading {
    margin: 0;
    text-align: center;
    padding-top: var(--se-heading-pt-mo);
    padding-bottom: var(--se-heading-pb-mo);
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-size: var(--se-heading-size-mo);
    font-weight: 400;
    line-height: 1.1;
    color: var(--se-c-heading);
    word-break: break-word;
  }

  .science-excluded__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--se-grid-gap-mo);
    padding-top: var(--se-grid-pt-mo);
    padding-bottom: var(--se-grid-pb-mo);
  }

  @media screen and (min-width: 750px) {
    .science-excluded__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--se-grid-gap-dk);
      padding-top: var(--se-grid-pt-dk);
      padding-bottom: var(--se-grid-pb-dk);
    }
  }

  .science-excluded__card {
    background-color: var(--se-c-card-bg);
    border: 0.5px solid var(--se-c-card-border);
    border-radius: 8px;
    padding: var(--se-card-pt-mo) var(--se-card-px-mo) var(--se-card-pb-mo);
    display: flex;
    flex-direction: column;
  }

  .science-excluded__card-name {
    margin: 0 0 8px;
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-size: var(--se-card-name-size-mo);
    font-weight: 500;
    color: var(--se-c-card-name);
  }

  .science-excluded__card-text {
    margin: 0;
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-size: var(--se-card-text-size-mo);
    font-weight: 300;
    line-height: 1.6;
    color: var(--se-c-card-text);
  }

  .science-excluded__card-text p {
    margin: 0;
    font: inherit;
    color: inherit;
  }

  @media screen and (min-width: 750px) {
    .science-excluded__heading {
      font-size: var(--se-heading-size-dk);
      padding-top: var(--se-heading-pt-dk);
      padding-bottom: var(--se-heading-pb-dk);
    }

    .science-excluded__card {
      padding: var(--se-card-pt-dk) var(--se-card-px-dk) var(--se-card-pb-dk);
    }

    .science-excluded__card-name {
      font-size: var(--se-card-name-size-dk);
    }

    .science-excluded__card-text {
      font-size: var(--se-card-text-size-dk);
    }
  }
{%- endstyle -%}

<div id="ScienceExcluded-{{ section.id }}" class="science-excluded section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <div class="science-excluded__inner">
      
      {%- if section.settings.heading != blank -%}
        <h2 class="science-excluded__heading">
          {{ section.settings.heading | newline_to_br }}
        </h2>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="science-excluded__grid">
          {%- for block in section.blocks -%}
            <div class="science-excluded__card" {{ block.shopify_attributes }}>
              {%- if block.settings.ingredient != blank -%}
                <h3 class="science-excluded__card-name">{{ block.settings.ingredient | escape }}</h3>
              {%- endif -%}
              
              {%- if block.settings.reason != blank -%}
                <div class="science-excluded__card-text rte">{{ block.settings.reason }}</div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Science Excluded",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
