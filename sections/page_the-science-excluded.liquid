      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Excluded Ingredient",
      "limit": 12,
      "settings": [
        {
          "type": "text",
          "id": "ingredient",
          "label": "Ingredient Name",
          "default": "Baking Soda"
        },
        {
          "type": "richtext",
          "id": "reason",
          "label": "Reason",
          "default": "<p>Causes irritation and pH imbalance in most users.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Science Excluded",
      "blocks": [
